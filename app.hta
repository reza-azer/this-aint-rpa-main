<!-- v1.4.1 -->
<!DOCTYPE html>
<html>
<head>
    <title>WCK-v1.4.1 DynamicHold Edition</title>
    <meta http-equiv="X-UA-Compatible" content="IE=10">
    <meta charset="UTF-8">
    <hta:application 
        id="appRecorder"
        applicationname="wickedwriteinputandclicked"
        border="thick"
        caption="yes"
        showintaskbar="yes"
        singleinstance="yes"
        sysmenu="yes"
        windowstate="normal"
    />
    <link rel="stylesheet" type="text/css" href="style.css">
</head>
<body onbeforeunload="vbscript:AppCleanExit()">

<div class="container">
    <div class="tab-nav">
        <button id="btnTabGen" class="tab-nav-btn tab-btn active" onclick="vbscript:SwitchTab('generator')">⚙️ Generator</button>
        <button id="btnTabLaunch" class="tab-nav-btn tab-btn" onclick="vbscript:SwitchTab('launcher')">🚀 Launcher</button>
    </div>

    <!-- TAB 1: GENERATOR -->
    <div id="tabGenerator" class="tab-content active">
        <div class="card">
            <h1 class="title-wicked"> WICKED </h2>
            <p class="subtitle">write input and clicked - stable version 1.3 (DynamicHold Enabled) <br> 
		use this for repetitive bored tasks, suggest when script is running, always supervise it <br>
		brought to you by <b>2602884207</b>
		</p>
            
            <!-- <div class="button-bar" style="margin-bottom: 20px;">
                <div class="button-group">
                    <button class="btn-primary" onclick="vbscript:BtnActionManual('CLICK')">🖱️ Click Manual</button>
                    <button class="btn-primary" onclick="vbscript:BtnActionManual('DOUBLE CLICK')">🖱️⚡ Dbl Click</button>
                    <button class="btn-primary" onclick="vbscript:BtnActionManual('RIGHT CLICK')">🖱️ Right Click</button>
                    <button class="btn-primary" style="background-color: #0284c7;" onclick="vbscript:BtnActionManual('MOVE CURSOR ONLY')">📍 Move Cursor</button>
                    <button class="btn-primary" onclick="vbscript:TriggerTextCapture()">⌨️ Type Text</button>
                    <button class="btn-primary" onclick="vbscript:TriggerShortcutCapture()">🖮 Key Shortcut</button>
                    <button class="btn-primary" style="background-color: #7c3aed;" onclick="vbscript:TriggerProgramCapture()">🛡️ Switch App</button>
                </div>
            </div> -->

            <div class="info-box">
                <b>GLOBAL MOUSE HOTKEYS (Auto Captures Position & Pixel Color):</b><br>
                • <kbd>Shift + C</kbd> : Left Click | • <kbd>Shift + D</kbd> : Double Click | • <kbd>Shift + R</kbd> : Right Click | • <kbd>Shift + M</kbd> : Move Cursor Only<br>
                • <kbd>Shift + W</kbd> : Scroll Up | • <kbd>Shift + S</kbd> : Scroll Down<br>
                • <kbd>Shift + E</kbd> : Point & Shoot Edit Baris (Edit Koordinat & Warna Baris yang Dipilih)<br>
                <b>GLOBAL KEYBOARD & RUNTIME HOTKEYS:</b><br>
                • <kbd>Shift + T</kbd> : Type Text (Input Dialog) | • <kbd>Shift + K</kbd> : Shortcut Wizard (Exact OSK)<br>
                • <kbd>Shift + P</kbd> : Switch & Focus Program Target App (Auto Force-Switch Active Window)<br><br>
                🧠 <b>DynamicHold:</b> Ketika merekam posisi via Hotkey, warna pixel otomatis tercatat! Set kolom 'Target Color' ke Hex Color untuk DynamicHold, atau ubah/kosongkan ke <b>STATIC WAIT</b> jika hanya ingin delay biasa.<br>
                💡 <b>MULTI-DRAG:</b> Tahan tombol <kbd>Ctrl</kbd> dan klik baris tabel untuk memilih beberapa baris sekaligus, lalu seret (drag & drop) untuk memindahkan semuanya bersamaan.
            </div>
        </div>

        <div class="card">
            <!-- TABEL 1: MAIN SEQUENCE -->
            <div id="boxMainTable" class="table-wrapper active-table-box" onclick="vbscript:SetActiveTable('MAIN')">
                <div class="table-title-bar">
                    <h2 style="margin:0; font-size:18px;">🎯 MAIN SEQUENCE TABLE <span class="active-badge">ACTIVE TARGET</span></h2>
                    <div>
                        <button class="btn-primary" style="background-color: #0284c7; padding:6px 12px; font-size:11px;" onclick="vbscript:SaveSequenceMetadata()">💾 Save Sequence</button>
                        <button class="btn-primary" style="background-color: #d97706; padding:6px 12px; font-size:11px;" onclick="vbscript:LoadSequenceMetadata()">📂 Load Sequence</button>
                    </div>
                </div>
                <table class="guide-table" id="reviewTable">
                    <thead>
                        <tr>
                            <th style="width: 18%;">Nama Langkah</th>
                            <th style="width: 13%;">Tipe Aksi</th>
                            <th style="width: 16%;">Koordinat (X, Y)</th>
                            <th style="width: 18%;">Target Color</th>
                            <th style="width: 20%;">Value / Parameter</th>
                            <th style="width: 10%;">Hold / Delay (ms)</th>
                            <th style="width: 5%;">Hapus</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>

            <!-- OPSI & TABEL 2: EXTRA SEQUENCE -->
            <div style="margin-top: 15px; margin-bottom: 15px;">
                <label style="font-weight: bold; color: #38bdf8; cursor: pointer; font-size: 14px;">
                    <input type="checkbox" id="chkExtraSeq" onclick="vbscript:ToggleExtraSeqUI()"> ➕ Add Extra Sequence (Langkah ekstra yang dieksekusi setelah seluruh loop utama selesai)
                </label>
            </div>

            <div id="extraSeqBox" class="extra-seq-container">
                <div id="boxExtraTable" class="table-wrapper" onclick="vbscript:SetActiveTable('EXTRA')">
                    <div class="table-title-bar">
                        <h3 style="margin:0; color:#38bdf8; font-size:16px;">⚡ EXTRA SEQUENCE TABLE <span class="active-badge">ACTIVE TARGET</span></h3>
                    </div>
                    <table class="guide-table" id="extraReviewTable">
                        <thead>
                            <tr>
                                <th style="width: 18%;">Nama Langkah</th>
                                <th style="width: 13%;">Tipe Aksi</th>
                                <th style="width: 16%;">Koordinat (X, Y)</th>
                                <th style="width: 18%;">Target Color</th>
                                <th style="width: 20%;">Value / Parameter</th>
                                <th style="width: 10%;">Hold / Delay (ms)</th>
                                <th style="width: 5%;">Hapus</th>
                            </tr>
                        </thead>
                        <tbody id="extraTableBody"></tbody>
                    </table>
                </div>
            </div>

            <br>
            <button class="btn-success" style="width: 100%; font-size: 15px; padding: 14px;" onclick="vbscript:GenerateVBSOnly()">💾 Generate Script Engine</button>
        </div>
    </div>

    <!-- TAB 2: LAUNCHER -->
    <div id="tabLauncher" class="tab-content">
        <div class="card">
            <h2>REAL-TIME EXECUTION OVERWATCH</h2>
            <p class="subtitle">Eksekusi file otomasi yang telah di-generate dan pantau progress baris instruksi secara real-time.</p>
            
            <div class="monitor-grid">
                <div class="monitor-box">
                    <span class="monitor-label">STATUS ENGINE</span>
                    <div class="status-scroll-container">
                        <span id="monStatus" class="status-scroll-text" style="color: #64748b;">IDLE</span>
                    </div>
                </div>
                <div class="monitor-box">
                    <span class="monitor-label">LOOP TRACKER</span>
                    <div id="monLoop" class="digital-7seg">0 / 0</div>
                </div>
                <div class="monitor-box">
                    <span class="monitor-label">CURRENT EXECUTING STEP</span>
                    <div id="monStep" style="font-size: 13px; text-align: center; color: #cbd5e1; font-weight:600;">-</div>
                </div>
            </div>

            <!-- COMPACT FUN TIPS & JOKES WIDGET -->
            <div class="tips-container">
                <div id="boxAtomLoader" class="loader-3d-box">
                    <div class="loader-3d">
                        <div class="inner-ring one"></div>
                        <div class="inner-ring two"></div>
                        <div class="inner-ring three"></div>
                    </div>
                </div>
                <div class="tips-text-content" id="txtFunTip">
                    💡 System ready. Silakan tekan RUN ENGINE untuk memulai eksekusi otomasi.
                </div>
            </div>

            <!-- DUAL PROGRESS BAR -->
            <div class="progress-container">
                <div class="progress-header">
                    <span>STEPS PROGRESS</span>
                    <span id="txtLoopProg">0%</span>
                </div>
                <div class="progress-bar-bg">
                    <div id="barLoopProg" class="progress-bar-fill"></div>
                </div>
            </div>

            <div class="progress-container">
                <div class="progress-header">
                    <span>OVERALL PROGRESS</span>
                    <span id="txtTotalProg">0%</span>
                </div>
                <div class="progress-bar-bg" id="bgTotalProg">
                    <div id="barTotalProg" class="progress-bar-fill total"></div>
                </div>
            </div>

            <div class="monitor-grid" style="margin-bottom: 20px;">
                <div class="monitor-box" style="min-height: 60px; padding: 10px;">
                    <span class="monitor-label">ELAPSED TIME</span>
                    <div id="txtElapsedTime" style="font-size: 16px; font-weight: 700; color: #cbd5e1;">00:00:00</div>
                </div>
                <div class="monitor-box" style="min-height: 60px; padding: 10px;">
                    <span class="monitor-label">EST TIME-TO-FINISHED</span>
                    <div id="txtEstTime" style="font-size: 16px; font-weight: 700; color: #f59e0b;">00:00:00</div>
                </div>
            </div>

            <div style="text-align: center; padding: 25px; background: #0b0f17; border-radius: 6px; border: 1px solid #1e293b;">
                <button id="btnMasterEngine" class="btn-success" style="font-size: 15px; padding: 14px 50px; min-width: 240px;" onclick="vbscript:ToggleEngineState()">▶️ RUN ENGINE</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DIALOGS -->
<div id="shortcutModal" class="modal-overlay">
    <div class="modal-box">
        <h3>Pilih Pre-built Shortcut Wizard</h3>
        <div class="shortcut-grid">
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('^c','Copy')">📄 Copy (Ctrl + C)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('^v','Paste')">📋 Paste (Ctrl + V)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('^z','Undo')">↩️ Undo (Ctrl + Z)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('^y','Redo')">↪️ Redo (Ctrl + Y)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('^s','Save')">💾 Save File (Ctrl + S)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('%{TAB}','AltTab')">🔄 Alt + TAB</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('{ENTER}','Enter')">↩️ Enter Key</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('{TAB}','Tab')">⇥ Tab Key</button>
            <button class="btn-shortcut-custom btn-shortcut-item" onclick="vbscript:OpenOSKModal()">⌨️ INTERACTIVE VISUAL OSK BUILDER...</button>
        </div>
        <button class="btn-modal-close" onclick="vbscript:CloseShortcutModal()">❌ Batal</button>
    </div>
</div>

<div id="oskModal" class="modal-overlay" style="z-index: 1001;">
