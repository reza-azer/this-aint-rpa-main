<!-- v1.5.0 -->
<!DOCTYPE html>
<html>
<head>
    <title>WCK-v1.5.0 Multi-Sequence Edition</title>
    <meta http-equiv="X-UA-Compatible" content="IE=10">
    <meta charset="UTF-8">
    <hta:application 
        id="appRecorder"
        applicationname="wickedwriteinputandclicked"
        border="thick"
        caption="yes"
        showintaskbar="yes"
        singleinstance="yes"
        sysmenu="yes"
        windowstate="normal"
    />
    <link rel="stylesheet" type="text/css" href="style.css">
</head>
<body onbeforeunload="vbscript:AppCleanExit()">

<div class="container">
    <div class="tab-nav">
        <button id="btnTabGen" class="tab-nav-btn tab-btn active" onclick="vbscript:SwitchTab('generator')">⚙️ Generator</button>
        <button id="btnTabLaunch" class="tab-nav-btn tab-btn" onclick="vbscript:SwitchTab('launcher')">🚀 Launcher</button>
    </div>

    <!-- TAB 1: GENERATOR -->
    <div id="tabGenerator" class="tab-content active">
        <div class="card">
            <span class="hero-kicker">⚡ Automation Control Deck</span>
            <h1 class="title-wicked">WICKED</h1>
            <p class="subtitle">
                <b style="color:#7dd3fc;">write · input · clicked</b> — build your mission, then let the machine run it.<br>
                Version 1.5 (Multi-Sequence Enabled) · one MAIN loop + unlimited branchable sequences via <b>CHECK PIXEL</b> triggers.<br>
                <span style="color:#64748b;">Heads-up:</span> always keep an eye on the script while it runs — you're the pilot, we're just the autopilot. <span style="opacity:.7;">· brought to you by <b>2602884207</b></span>
            </p>

            <div class="info-box">
                <span class="hotkey-title">🎮 THE REMOTE</span> — every hotkey below captures your cursor position <i>and</i> its pixel color in one shot.<br>
                <div class="info-group">
                    <span class="hotkey-title">🖱️ Mouse Playbook</span><br>
                    <span class="hotkey-line"><kbd>Shift</kbd>+<kbd>C</kbd> Left Click</span> ·
                    <span class="hotkey-line"><kbd>Shift</kbd>+<kbd>D</kbd> Double Click</span> ·
                    <span class="hotkey-line"><kbd>Shift</kbd>+<kbd>R</kbd> Right Click</span> ·
                    <span class="hotkey-line"><kbd>Shift</kbd>+<kbd>M</kbd> Move Cursor</span><br>
                    <span class="hotkey-line"><kbd>Shift</kbd>+<kbd>W</kbd> Scroll Up</span> ·
                    <span class="hotkey-line"><kbd>Shift</kbd>+<kbd>S</kbd> Scroll Down</span><br>
                    <span class="hotkey-line"><kbd>Shift</kbd>+<kbd>O</kbd> Screenshot (Full)</span> ·
                    <span class="hotkey-line"><kbd>Shift</kbd>+<kbd>I</kbd> Screenshot (Drag Region)</span><br>
                    <span class="hotkey-line"><kbd>Shift</kbd>+<kbd>E</kbd> Point &amp; Shoot — tweak the selected row's spot</span>
                </div>
                <div class="info-group">
                    <span class="hotkey-title">⌨️ Keyboard &amp; Runtime Playbook</span><br>
                    <span class="hotkey-line"><kbd>Shift</kbd>+<kbd>T</kbd> Type Text</span> ·
                    <span class="hotkey-line"><kbd>Shift</kbd>+<kbd>K</kbd> Shortcut Wizard (OSK)</span> ·
                    <span class="hotkey-line"><kbd>Shift</kbd>+<kbd>P</kbd> Switch &amp; Focus App</span> ·
                    <span class="hotkey-line"><kbd>Shift</kbd>+<kbd>X</kbd> Check Pixel (branch trigger)</span>
                </div>
                <div class="info-group">
                    🧠 <span class="hotkey-title">DynamicHold:</span> record a spot with a hotkey and its pixel color tags along automatically. Drop a <span class="tip-em">Hex Color</span> in the <b>Target Color</b> column to make the engine wait for that exact hue — or set it to <b>STATIC WAIT</b> for a plain timed delay.<br>
                    💡 <span class="hotkey-title">Multi-Drag:</span> hold <kbd>Ctrl</kbd> + click several rows, then drag them all to reorder the whole squad in one move.
                </div>
            </div>

            <div class="hero-buttons">
                <button class="btn-primary" onclick="vbscript:TriggerTextCapture()">⌨️ Type Text</button>
                <button class="btn-primary" onclick="vbscript:TriggerShortcutCapture()">🖮 Key Shortcut</button>
                <button class="btn-primary" style="background-image:linear-gradient(135deg,#7c3aed,#8b5cf6);" onclick="vbscript:TriggerProgramCapture()">🛡️ Switch App</button>
            </div>
        </div>

        <div class="folder-row">
            <label class="folder-label" for="inpShotFolder">📁 Evident locker (folder):</label>
            <input type="text" id="inpShotFolder" class="folder-input" placeholder="misal: screenshot">
            <span class="folder-hint">Screenshots disimpan ke folder ini (di dalam folder app) dengan nama &lt;folder&gt;_1.png, &lt;folder&gt;_2.png, dst. — tidak akan tertimpa pada sesi berikutnya.</span>
        </div>

<div class="card">
                <!-- SEQUENCE TABS BAR -->
                <div class="seq-tabs-bar">
                    <span class="seq-tabs-label">🧩 Sequences</span>
                    <div class="seq-tabs-container" id="seqTabsContainer"><!-- filled by RebuildSeqTabs --></div>
                    <button class="btn-seq-add" onclick="vbscript:AddNewSequence()">＋ New Sequence</button>
                </div>

                <!-- SEQUENCE PANELS -->
                <div id="seqContainer">
                    <!-- MAIN SEQUENCE panel (fixed, always exists) -->
                    <div id="seqPanel_MAIN" class="table-wrapper seq-panel seq-panel-active active-table-box">
                        <div class="table-title-bar">
                            <h2 class="table-title"><span class="table-ico">🎯</span> <span id="seqTitle_MAIN">MAIN SEQUENCE</span> <span class="active-badge">Active target</span></h2>
                            <div>
                                <button class="btn-primary" style="background-image:linear-gradient(135deg,#0284c7,#0ea5e9); padding:7px 14px; font-size:11px;" onclick="vbscript:SaveSequenceMetadata()">💾 Save Sequence</button>
                                <button class="btn-primary" style="background-image:linear-gradient(135deg,#d97706,#f59e0b); padding:7px 14px; font-size:11px;" onclick="vbscript:LoadSequenceMetadata()">📂 Load Sequence</button>
                            </div>
                        </div>
                        <p class="sub-hint">The main loop — every step below repeats for each loop. <b>CHECK PIXEL</b> memicu percabangan: <b>WAIT</b> (do nothing, tunggu warna cocok), <b>SKIP</b> (lompat ke perulangan berikutnya), atau <b>SWITCH</b> (ganti ke sequence lain sekali jalan, lalu lanjut step MAIN berikutnya).</p>
                        <table class="guide-table">
                            <thead>
                                <tr>
                                    <th style="width: 18%;">Step Name</th>
                                    <th style="width: 13%;">Action</th>
                                    <th style="width: 16%;">Spot (X, Y)</th>
                                    <th style="width: 18%;">Target Color</th>
                                    <th style="width: 20%;">Value / Param</th>
                                    <th style="width: 10%;">Delay (ms)</th>
                                    <th style="width: 5%;">Tools</th>
                                </tr>
                            </thead>
                            <tbody id="seqTbody_MAIN" data-seqname="MAIN"></tbody>
                        </table>
                    </div>
                    <!-- extra sequence panels are appended here by VBScript -->
                </div>

                <br>
                <button class="btn-success" style="width: 100%; font-size: 15px; padding: 15px; letter-spacing: 1px;" onclick="vbscript:GenerateVBSOnly()">⚙️ Generate Script Engine</button>
            </div>
    </div>

    <!-- TAB 2: LAUNCHER -->
    <div id="tabLauncher" class="tab-content">
        <div class="card">
            <span class="hero-kicker">🛰️ Mission Control</span>
            <h2 style="margin-bottom:6px;">REAL-TIME EXECUTION OVERWATCH</h2>
            <p class="subtitle">Fire up the generated script and track every instruction line as it executes, live. You're in command — watch the dials.</p>
            
            <div class="monitor-grid">
                <div class="monitor-box">
                    <span class="monitor-label">STATUS ENGINE</span>
                    <div class="status-scroll-container">
                        <span id="monStatus" class="status-scroll-text" style="color: #64748b;">IDLE</span>
                    </div>
                </div>
                <div class="monitor-box">
                    <span class="monitor-label">LOOP TRACKER</span>
                    <div id="monLoop" class="digital-7seg sevenseg-wrap"><span class="sevenseg-ghost" id="monLoopGhost">8 / 8</span><span class="sevenseg-live" id="monLoopLive">0 / 0</span></div>
                </div>
                <div class="monitor-box">
                    <span class="monitor-label">CURRENT EXECUTING STEP</span>
                    <div id="monStep" style="font-size: 13px; text-align: center; color: #cbd5e1; font-weight:600;">-</div>
                </div>
            </div>

            <!-- COMPACT FUN TIPS & JOKES WIDGET -->
            <div class="tips-container">
                <div id="boxAtomLoader" class="loader-3d-box">
                    <div class="loader-3d">
                        <div class="inner-ring one"></div>
                        <div class="inner-ring two"></div>
                        <div class="inner-ring three"></div>
                    </div>
                </div>
                <div class="tips-text-content" id="txtFunTip">
                    💡 System ready. Silakan tekan RUN ENGINE untuk memulai eksekusi otomasi.
                </div>
            </div>

            <!-- DUAL PROGRESS BAR -->
            <div class="progress-container">
                <div class="progress-header">
                    <span>STEPS PROGRESS</span>
                    <span id="txtLoopProg">0%</span>
                </div>
                <div class="progress-bar-bg">
                    <div id="barLoopProg" class="progress-bar-fill"></div>
                </div>
            </div>

            <div class="progress-container">
                <div class="progress-header">
                    <span>OVERALL PROGRESS</span>
                    <span id="txtTotalProg">0%</span>
                </div>
                <div class="progress-bar-bg" id="bgTotalProg">
                    <div id="barTotalProg" class="progress-bar-fill total"></div>
                </div>
            </div>

            <div class="monitor-grid" style="margin-bottom: 20px;">
                <div class="monitor-box" style="min-height: 60px; padding: 10px;">
                    <span class="monitor-label">ELAPSED TIME</span>
                    <div id="txtElapsedTime" style="font-size: 16px; font-weight: 700; color: #cbd5e1;">00:00:00</div>
                </div>
                <div class="monitor-box" style="min-height: 60px; padding: 10px;">
                    <span class="monitor-label">EST TIME-TO-FINISHED</span>
                    <div id="txtEstTime" style="font-size: 16px; font-weight: 700; color: #f59e0b;">00:00:00</div>
                </div>
            </div>

            <div class="action-hub">
                <button id="btnMasterEngine" class="btn-success run-btn-glow" style="font-size: 16px; padding: 15px 54px; min-width: 240px;" onclick="vbscript:ToggleEngineState()">▶️ RUN ENGINE</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DIALOGS -->
<div id="shortcutModal" class="modal-overlay">
    <div class="modal-box">
        <h3>🖮 Pick a Pre-built Shortcut</h3>
        <div class="shortcut-grid">
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('^c','Copy')">📄 Copy (Ctrl + C)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('^v','Paste')">📋 Paste (Ctrl + V)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('^z','Undo')">↩️ Undo (Ctrl + Z)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('^y','Redo')">↪️ Redo (Ctrl + Y)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('^s','Save')">💾 Save File (Ctrl + S)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('%{TAB}','AltTab')">🔄 Alt + TAB</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('{ENTER}','Enter')">↩️ Enter Key</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectShortcut('{TAB}','Tab')">⇥ Tab Key</button>
            <button class="btn-shortcut-custom btn-shortcut-item" onclick="vbscript:OpenOSKModal()">⌨️ INTERACTIVE VISUAL OSK BUILDER...</button>
        </div>
        <button class="btn-modal-close" onclick="vbscript:CloseShortcutModal()">❌ Batal</button>
    </div>
</div>

<div id="oskModal" class="modal-overlay" style="z-index: 1001;">
    <div class="modal-box" style="width: 820px; background: #111827; border: 1px solid #3b82f6;">
        <h3 style="color:#ffffff; margin-bottom:10px;">⌨️ Keyboard Combination Builder</h3>
        <div style="background:rgba(9,14,28,0.9); padding:12px 15px; border-radius:8px; font-weight:700; margin-bottom:15px; font-size:14px; text-align:left; color:#7dd3fc; border: 1px solid rgba(56,189,248,0.30); box-shadow: inset 0 0 20px rgba(56,189,248,0.06);">
            SendKeys Script Output: <span id="oskPreview" style="color:#f59e0b; text-shadow:0 0 10px rgba(245,158,11,0.5);">-</span>
        </div>
        <div class="exact-osk-window">
            <table class="osk-table-row">
                <tr>
                    <td width="7%"><div class="k-btn modifier" onclick="vbscript:PressBaseKey('{ESC}')">Esc</div></td>
                    <td width="6%"><div class="k-btn" onclick="vbscript:PressBaseKey('`')"><span class="sub-txt">~</span>`</div></td>
                    <td width="6%"><div class="k-btn" onclick="vbscript:PressBaseKey('1')"><span class="sub-txt">!</span>1</div></td>
                    <td width="6%"><div class="k-btn" onclick="vbscript:PressBaseKey('2')"><span class="sub-txt">@</span>2</div></td>
                    <td width="6%"><div class="k-btn" onclick="vbscript:PressBaseKey('3')"><span class="sub-txt">#</span>3</div></td>
                    <td width="6%"><div class="k-btn" onclick="vbscript:PressBaseKey('4')"><span class="sub-txt">$</span>4</div></td>
                    <td width="6%"><div class="k-btn" onclick="vbscript:PressBaseKey('5')"><span class="sub-txt">%</span>5</div></td>
                    <td width="6%"><div class="k-btn" onclick="vbscript:PressBaseKey('6')"><span class="sub-txt">^</span>6</div></td>
                    <td width="6%"><div class="k-btn" onclick="vbscript:PressBaseKey('7')"><span class="sub-txt">&amp;</span>7</div></td>
                    <td width="6%"><div class="k-btn" onclick="vbscript:PressBaseKey('8')"><span class="sub-txt">*</span>8</div></td>
                    <td width="6%"><div class="k-btn" onclick="vbscript:PressBaseKey('9')"><span class="sub-txt">(</span>9</div></td>
                    <td width="6%"><div class="k-btn" onclick="vbscript:PressBaseKey('0')"><span class="sub-txt">)</span>0</div></td>
                    <td width="6%"><div class="k-btn" onclick="vbscript:PressBaseKey('-')"><span class="sub-txt">_</span>-</div></td>
                    <td width="6%"><div class="k-btn" onclick="vbscript:PressBaseKey('=')"><span class="sub-txt">+</span>=</div></td>
                    <td width="8%"><div class="k-btn modifier" onclick="vbscript:PressBaseKey('{BACKSPACE}')">🖮 ⌫</div></td>
                </tr>
            </table>
            <table class="osk-table-row">
                <tr>
                    <td width="9%"><div class="k-btn modifier" onclick="vbscript:PressBaseKey('{TAB}')">Tab</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('q')">q</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('w')">w</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('e')">e</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('r')">r</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('t')">t</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('y')">y</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('u')">u</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('i')">i</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('o')">o</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('p')">p</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('[')"><span class="sub-txt">{</span>[</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey(']')"><span class="sub-txt">}</span>]</div></td>
                    <td width="12.5%"><div class="k-btn modifier" onclick="vbscript:PressBaseKey('{ENTER}')">Enter</div></td>
                </tr>
            </table>
            <table class="osk-table-row">
                <tr>
                    <td width="11%"><div id="k_CAPSLOCK" class="k-btn modifier" onclick="vbscript:PressBaseKey('{CAPSLOCK}')">Caps</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('a')">a</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('s')">s</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('d')">d</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('f')">f</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('g')">g</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('h')">h</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('j')">j</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('k')">k</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('l')">l</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey(';')"><span class="sub-txt">:</span>;</div></td>
                    <td width="6.5%"><div class="k-btn" onclick='vbscript:PressBaseKey(Chr(39))'><span class="sub-txt">&quot;</span>'</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('\')"><span class="sub-txt">|</span>\</div></td>
                </tr>
            </table>
            <table class="osk-table-row">
                <tr>
                    <td width="15%"><div id="k_SHIFT" class="k-btn modifier" onclick="vbscript:ToggleModifier('SHIFT')">Shift</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('z')">z</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('x')">x</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('c')">c</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('v')">v</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('b')">b</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('n')">n</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('m')">m</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey(',')"><span class="sub-txt">&lt;</span>,</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('.')"><span class="sub-txt">&gt;</span>.</div></td>
                    <td width="6.5%"><div class="k-btn" onclick="vbscript:PressBaseKey('/')"><span class="sub-txt">?</span>/</div></td>
                    <td width="6.5%"><div class="k-btn modifier" onclick="vbscript:PressBaseKey('{UP}')">▲</div></td>
                    <td width="8%"><div id="k_SHIFT_R" class="k-btn modifier" onclick="vbscript:ToggleModifier('SHIFT')">Shift</div></td>
                    <td width="6.5%"><div class="k-btn modifier" onclick="vbscript:PressBaseKey('{DEL}')">Del</div></td>
                </tr>
            </table>
            <table class="osk-table-row">
                <tr>
                    <td width="9.5%"><div id="k_CTRL" class="k-btn modifier" onclick="vbscript:ToggleModifier('CTRL')">Ctrl</div></td>
                    <td width="9.5%"><div class="k-btn modifier" onclick="vbscript:PressBaseKey('^{ESC}')">⊞</div></td>
                    <td width="9.5%"><div id="k_ALT" class="k-btn modifier" onclick="vbscript:ToggleModifier('ALT')">Alt</div></td>
                    <td width="42.5%"><div class="k-btn" style="color:transparent;" onclick="vbscript:PressBaseKey(' ')">Spacebar</div></td>
                    <td width="9.5%"><div id="k_CTRL_R" class="k-btn modifier" onclick="vbscript:ToggleModifier('CTRL')">Ctrl</div></td>
                    <td width="6.5%"><div class="k-btn modifier" onclick="vbscript:PressBaseKey('{LEFT}')">◀</div></td>
                    <td width="6.5%"><div class="k-btn modifier" onclick="vbscript:PressBaseKey('{DOWN}')">▼</div></td>
                    <td width="6.5%"><div class="k-btn modifier" onclick="vbscript:PressBaseKey('{RIGHT}')">▶</div></td>
                </tr>
            </table>
        </div>
        <div style="margin-bottom: 15px; text-align: left; padding: 0 10px;">
            <label style="font-weight: 700; font-size:13px; display:block; margin-bottom:5px; color:#ffffff;">Nama Custom Shortcut:</label>
            <input type="text" id="oskShortcutName" class="input-inline" style="width:100%;" value="Custom Combo">
        </div>
        <button class="btn-success" style="padding: 10px 25px;" onclick="vbscript:SaveOSKShortcut()">Simpan & Terapkan</button>
        <button class="btn-modal-close" style="margin-left:8px;" onclick="vbscript:CloseOSKModal()">❌ Batal</button>
    </div>
</div>

<div id="programModal" class="modal-overlay">
    <div class="modal-box">
        <h3>🛡️ Target Window &amp; Switch Focus</h3>
        <p style="font-size:12px; color:#94a3b8; margin-top:-10px; margin-bottom:20px;">Sistem akan otomatis memaksa Windows fokus ke aplikasi ini sebelum eksekusi berlanjut.</p>
        <div class="shortcut-grid">
            <button class="btn-shortcut-item" onclick="vbscript:SelectProgram('Microsoft Word','winword.exe')">📄 Word (winword.exe)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectProgram('Microsoft Excel','excel.exe')">📊 Excel (excel.exe)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectProgram('Notepad','notepad.exe')">📝 Notepad (notepad.exe)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectProgram('Sticky Notes','Microsoft.Notes.exe')">📌 Sticky Notes</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectProgram('Microsoft Edge','msedge.exe')">🌐 Edge (msedge.exe)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectProgram('Google Chrome','chrome.exe')">🌐 Chrome (chrome.exe)</button>
            <button class="btn-shortcut-item" onclick="vbscript:SelectProgram('Mozilla Firefox','firefox.exe')">🌐 Firefox (firefox.exe)</button>
            <button class="btn-shortcut-item btn-shortcut-custom" onclick="vbscript:SelectProgram('CUSTOM','')">🛠️ TARGET PROSES KUSTOM...</button>
        </div>
        <button class="btn-modal-close" onclick="vbscript:CloseProgramModal()">❌ Batal</button>
    </div>
</div>

<div id="sequencePickerModal" class="modal-overlay" style="z-index: 1001;">
    <div class="modal-box" style="width: 560px;">
        <h3>📂 Load Saved Sequence</h3>
        <p class="sub-hint" style="margin-bottom:12px;">Pick a sequence to load into the tables:</p>
        <div class="sequence-list" id="sequenceListContainer">
            <!-- populated by VBScript PopulateSequencePicker() -->
        </div>
        <button class="btn-modal-close" onclick="vbscript:CloseSequencePicker()">❌ Cancel</button>
    </div>
</div>

<script type="text/javascript">
    var draggedRows = [];
    var lastSelectedRow = null;

    var regionPollTimer = null;
    var regionWaitPath = "";
    var regionTimeoutCount = 0;

    function StartRegionPoll(tmpPath) {
        regionWaitPath = tmpPath;
        regionTimeoutCount = 0;
        if (regionPollTimer) { clearInterval(regionPollTimer); regionPollTimer = null; }
        regionPollTimer = setInterval("PollRegionFile()", 250);
    }

    function CleanUpShotFiles() {
        try {
            var fs = new ActiveXObject('Scripting.FileSystemObject');
            var idx = regionWaitPath.lastIndexOf('/');
            var appDir = idx > 0 ? regionWaitPath.substring(0, idx) : 'D:/App/this-aint-rpa-main';
            if (fs.FileExists(appDir + '/screenshot_region.tmp')) fs.DeleteFile(appDir + '/screenshot_region.tmp', true);
            if (fs.FileExists(appDir + '/screenshot_preview.png')) fs.DeleteFile(appDir + '/screenshot_preview.png', true);
            if (fs.FileExists(appDir + '/screenshot_overlay.hta')) fs.DeleteFile(appDir + '/screenshot_overlay.hta', true);
        } catch (e) {}
    }

    function PollRegionFile() {
        try {
            var fs = new ActiveXObject('Scripting.FileSystemObject');
            if (regionWaitPath != "" && fs.FileExists(regionWaitPath)) {
                if (regionPollTimer) { clearInterval(regionPollTimer); regionPollTimer = null; }
                var f = fs.OpenTextFile(regionWaitPath, 1);
                var line = f.ReadLine(); f.Close();
                fs.DeleteFile(regionWaitPath, true);
                var p = line.split(',');
                var x1 = parseInt(p[0]), y1 = parseInt(p[1]);
                CleanUpShotFiles();
                window.CompleteRegionCapture(x1, y1, parseInt(p[2]), parseInt(p[3]));
                return;
            }
            regionTimeoutCount++;
            if (regionTimeoutCount > 120) {
                if (regionPollTimer) { clearInterval(regionPollTimer); regionPollTimer = null; }
                CleanUpShotFiles();
            }
        } catch (e) {}
    }

    function InitDragAndDropListeners(rowElement) {
        rowElement.setAttribute("draggable", "true");

        // Fitur Multi-Select Baris Tabel
        rowElement.addEventListener("click", function(e) {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT' || e.target.tagName === 'BUTTON') {
                return;
            }
            if (e.ctrlKey) {
                this.classList.toggle("selected-row");
            } else {
                var tbody = this.parentNode;
                var rows = tbody.querySelectorAll("tr");
                for (var i = 0; i < rows.length; i++) {
                    rows[i].classList.remove("selected-row");
                }
                this.classList.add("selected-row");
            }
            lastSelectedRow = this;
        });

        // Drag & Drop Sekaligus Banyak Baris
        rowElement.addEventListener("dragstart", function(e) {
            var tbody = this.parentNode;
            var selected = tbody.querySelectorAll("tr.selected-row");
            if (selected.length === 0 || Array.prototype.indexOf.call(selected, this) === -1) {
                for (var i = 0; i < selected.length; i++) {
                    selected[i].classList.remove("selected-row");
                }
                this.classList.add("selected-row");
                draggedRows = [this];
            } else {
                draggedRows = Array.prototype.slice.call(selected);
            }

            if (e.dataTransfer) {
                e.dataTransfer.effectAllowed = "move";
                try { e.dataTransfer.setData("Text", this.id || ""); } catch(err) {}
            }
        });

        rowElement.addEventListener("dragover", function(e) {
            if (e.preventDefault) { e.preventDefault(); }
            this.classList.add("drag-over");
            return false;
        });

        rowElement.addEventListener("dragleave", function(e) { 
            this.classList.remove("drag-over"); 
        });

        rowElement.addEventListener("drop", function(e) {
            if (e.preventDefault) { e.preventDefault(); }
            if (e.stopPropagation) { e.stopPropagation(); }
            this.classList.remove("drag-over");

            if (draggedRows.length > 0 && draggedRows.indexOf(this) === -1) {
                var tbody = this.parentNode;
                var allRows = Array.prototype.slice.call(tbody.children);
                var targetIdx = allRows.indexOf(this);

                draggedRows.forEach(function(row) {
                    var currentIdx = Array.prototype.slice.call(tbody.children).indexOf(row);
                    if (currentIdx < targetIdx) {
                        tbody.insertBefore(row, this.nextSibling);
                    } else {
                        tbody.insertBefore(row, this);
                    }
                }, this);
            }
            return false;
        });
    }

    function ClosestRow(el) {
        while (el && el.tagName !== 'TR') { el = el.parentNode; }
        return el;
    }

    function DeleteRowBtn(btn) {
        var tr = ClosestRow(btn);
        if (tr && tr.parentNode) { tr.parentNode.removeChild(tr); }
    }

    function DuplicateRowBtn(btn) {
        var tr = ClosestRow(btn);
        if (!tr || !tr.parentNode) { return; }
        var clone = tr.cloneNode(true);
        var all = clone.getElementsByTagName('*');
        for (var i = 0; i < all.length; i++) {
            if (all[i].getAttribute && all[i].getAttribute('id')) {
                all[i].removeAttribute('id');
            }
        }
        if (clone.getAttribute && clone.getAttribute('id')) { clone.removeAttribute('id'); }
        tr.parentNode.insertBefore(clone, tr.nextSibling);
        InitDragAndDropListeners(clone);
    }

    function UpdateSelectedRowCoordinatesAndColor(x, y, hexColor) {
        var activeTableId = window.activeSeqTbodyId || 'seqTbody_MAIN';
        var tbody = document.getElementById(activeTableId);
        if (!tbody) return false;
        
        var selected = tbody.querySelector("tr.selected-row");
        if (!selected) return false;

        var coordInput = selected.querySelector(".status-coord");
        var colorInput = selected.querySelector(".status-color");
        
        if (coordInput) coordInput.value = x + ", " + y;
        if (colorInput) {
            colorInput.value = hexColor;
            var chip = selected.querySelector(".color-preview-chip");
            if (chip) chip.style.backgroundColor = (hexColor.indexOf("#") === 0) ? hexColor : "transparent";
        }
        return true;
    }

    function AnimateStatusText(newText, newColor) {
        var el = document.getElementById("monStatus");
        if (!el || el.innerText === newText) return;
        el.className = "status-scroll-text scroll-out";
        setTimeout(function() {
            el.innerText = newText;
            el.style.color = newColor;
            el.className = "status-scroll-text scroll-in";
            setTimeout(function() {
                el.className = "status-scroll-text";
            }, 50);
        }, 200);
    }

    function UpdateColorChip(inputEl) {
        var val = inputEl ? inputEl.value.trim() : '';
        var chip = inputEl ? inputEl.parentNode.querySelector('.color-preview-chip') : null;
        if (chip) {
            if (val.indexOf("#") === 0 && val.length === 7) {
                chip.style.backgroundColor = val;
            } else {
                chip.style.backgroundColor = "transparent";
            }
        }
    }

    // --- Multi-sequence: dynamic Value/Param cell (CHECK PIXEL branch selector) ---
    window.arrSeqNamesJS = ["MAIN"];

    function SetSeqList(delimStr) {
        window.arrSeqNamesJS = String(delimStr).split('|');
    }

    function BuildBranchSelect(curVal, seqName) {
        var html = "<select class='select-inline status-param'>";
        function optTag(v, label, isSel) {
            return "<option value='" + v + "'" + (isSel ? " selected" : "") + ">" + label + "</option>";
        }
        curVal = String(curVal || '');
        var curUp = curVal.toUpperCase();
        html += optTag("WAIT", "WAIT \u2014 Do nothing (nunggu warna cocok)",
                       (curVal === '' || curUp === 'WAIT'));
        html += optTag("SKIP", "SKIP \u2014 Lompat ke perulangan berikutnya", curUp === 'SKIP');
        var names = window.arrSeqNamesJS || ["MAIN"];
        for (var i = 0; i < names.length; i++) {
            var n = names[i];
            if (!n || n.toUpperCase() === String(seqName).toUpperCase()) continue;
            var v = "SEQ:" + n;
            html += optTag(v, "SWITCH \u2192 " + n, curUp === v.toUpperCase());
        }
        html += "</select>";
        return html;
    }

    function SyncParamField(ref) {
        var actSel = (typeof ref === 'number' || (typeof ref === 'string' && /^\d+$/.test(ref)))
            ? document.getElementById("inp_act_" + ref)
            : ref;
        if (!actSel) return;
        var row = ClosestRow(actSel);
        if (!row || !row.cells[4]) return;
        var tbody = row.parentNode;
        var seqName = (tbody && tbody.getAttribute) ? (tbody.getAttribute('data-seqname') || 'MAIN') : 'MAIN';
        var paramTd = row.cells[4];
        var curSel = paramTd.querySelector('.status-param');
        var curVal = curSel ? curSel.value : '';
        if (actSel.value === 'CHECK PIXEL') {
            paramTd.innerHTML = BuildBranchSelect(curVal, seqName);
        } else {
            if (curVal === 'WAIT' || curVal === 'SKIP' || /^SEQ:/i.test(curVal)) curVal = '-';
            var esc = String(curVal).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
            paramTd.innerHTML = "<input type='text' class='input-inline status-param' value='" + esc + "'>";
        }
    }
</script>

<script language="vbscript">
Sub AppCleanExit()
     On Error Resume Next
     ' Ensure the primary HTA Excel process is gracefully destroyed upon clicking 'X'
     If IsObject(objExcelEngine) Then
         objExcelEngine.Quit
         Set objExcelEngine = Nothing
     End If

     ' Ensure temporary status logs are cleared out
     If FSO.FileExists(PathStatusTmp) Then FSO.DeleteFile(PathStatusTmp)
 End Sub

    Dim activeSeqName, gRowIdCounter, lastRowGid, arrSeqNames
    activeSeqName = "MAIN"
    gRowIdCounter = 0
    lastRowGid = 0
    ReDim arrSeqNames(0)
    arrSeqNames(0) = "MAIN"
    
    Dim timerId, loopOpt
    Dim engineActive, isLaunchingState, isTerminatingState
    engineActive = False
    isLaunchingState = False
    isTerminatingState = False
    
    Dim startTime, prepMsgIdx, lastEstUpdateSec, tipTimerCounter
    startTime = 0
    prepMsgIdx = 0
    lastEstUpdateSec = -10
    tipTimerCounter = 0

    Dim arrFunTips
    arrFunTips = Array( _
        "💡 TIPS: DynamicHold akan menunggu pixel warna target sebelum melakukan klik!", _
        "💡 TIPS: Gunakan Shift+K untuk membuka Visual Keyboard Builder yang lengkap!", _
        "🤣 JOKES: Mau PL1 dong...", _
        "💡 TIPS: Kalo udah teken Terminate/Run Sekali, gausah teken lagi bro!", _
        "🤣 JOKES: Yang baca ga gay!", _
        "💡 TIPS: Kamu bisa menukar urutan baris dengan drag & drop sekaligus banyak baris.", _
        "🤣 JOKES: English or Spanish?...", _
        "💡 TIPS: Gunakan Shift+E untuk Point & Shoot edit koordinat dan warna pada baris terpilih.", _
        "🤣 JOKES: Tinggalin aja, gausah ditonton terus napa, ntar juga kelar..." _
    )

    Dim isCtrlActive, isShiftActive, isAltActive, selectedBaseKey
    isCtrlActive = False: isShiftActive = False: isAltActive = False: selectedBaseKey = ""

    Dim wshShell, FSO, PathStatusTmp, PathPauseTmp, objExcelEngine
    Set wshShell = CreateObject("WScript.Shell")
    Set FSO = CreateObject("Scripting.FileSystemObject")
    
    PathStatusTmp = wshShell.CurrentDirectory & "\wstatus.tmp"
    PathPauseTmp = wshShell.CurrentDirectory & "\trench_pause.tmp"

    Sub Window_OnLoad
        window.resizeTo 1250, 920
        On Error Resume Next
        Set objExcelEngine = CreateObject("Excel.Application")
        window.activeSeqName = "MAIN"
        window.activeSeqTbodyId = "seqTbody_MAIN"
        gRowIdCounter = 0
        ReDim arrSeqNames(0)
        arrSeqNames(0) = "MAIN"
        Call SyncSeqListToJS()
        Call RebuildSeqTabs()
        document.body.focus()
        Randomize
    End Sub

    Function SeqKey(raw)
        Dim c, i, out
        If LCase(raw) = "main" Then
            SeqKey = "MAIN"
            Exit Function
        End If
        out = "S"
        For i = 1 To Len(raw)
            c = Mid(raw, i, 1)
            If (c >= "A" And c <= "Z") Or (c >= "a" And c <= "z") Or (c >= "0" And c <= "9") Then
                out = out & c
            Else
                out = out & "_"
            End If
        Next
        SeqKey = out
    End Function

    Function SeqExists(seqName)
        Dim i
        SeqExists = False
        For i = 0 To UBound(arrSeqNames)
            If LCase(arrSeqNames(i)) = LCase(seqName) Then SeqExists = True : Exit Function
        Next
    End Function

    Sub AddSeqToList(seqName)
        Dim n
        n = UBound(arrSeqNames) + 1
        ReDim Preserve arrSeqNames(n)
        arrSeqNames(n) = seqName
    End Sub

    Sub RemoveFromSeqList(seqName)
        Dim i, j, tmp()
        For i = UBound(arrSeqNames) To 0 Step -1
            If LCase(arrSeqNames(i)) = LCase(seqName) Then
                For j = i To UBound(arrSeqNames) - 1
                    arrSeqNames(j) = arrSeqNames(j + 1)
                Next
                ReDim Preserve arrSeqNames(UBound(arrSeqNames) - 1)
                Exit For
            End If
        Next
    End Sub

    Sub SyncSeqListToJS()
        Dim i, s
        s = ""
        For i = 0 To UBound(arrSeqNames)
            If i > 0 Then s = s & "|"
            s = s & arrSeqNames(i)
        Next
        window.SetSeqList s
    End Sub

    Sub SetActiveSequence(seqName)
        On Error Resume Next
        activeSeqName = seqName
        window.activeSeqName = seqName
        window.activeSeqTbodyId = "seqTbody_" & SeqKey(seqName)
        Dim i, panelId, panelEl
        For i = 0 To UBound(arrSeqNames)
            panelId = "seqPanel_" & SeqKey(arrSeqNames(i))
            Set panelEl = document.getElementById(panelId)
            If Not panelEl Is Nothing Then
                If LCase(arrSeqNames(i)) = LCase(seqName) Then
                    panelEl.className = "table-wrapper seq-panel seq-panel-active active-table-box"
                Else
                    panelEl.className = "table-wrapper seq-panel"
                End If
            End If
        Next
        Call RebuildSeqTabs()
        document.body.focus()
    End Sub

    Function SeqPanelHtml(seqName, key, includeTbody)
        Dim h
        h = "<div class='table-title-bar'>" & _
            "<h3 class='table-title'><span class='table-ico'>🧩</span> <span id='seqTitle_" & key & "'>" & HtmlEncodeAttr(seqName) & "</span></h3>" & _
            "<div>" & _
                "<button class='btn-seq-mini' onclick=""vbscript:RenameSequence('" & seqName & "')"">✏️ Rename</button>" & _
                "<button class='btn-seq-mini' onclick=""vbscript:DeleteSequence('" & seqName & "')"">🗑️ Delete</button>" & _
            "</div>" & _
        "</div>" & _
        "<p class='sub-hint'>Tidak ikut loop utama — jalan sekali setiap kali dipicu oleh step <b>CHECK PIXEL → SWITCH</b> di sequence mana pun.</p>" & _
        "<table class='guide-table'>" & _
            "<thead><tr>" & _
                "<th style='width: 18%;'>Step Name</th>" & _
                "<th style='width: 13%;'>Action</th>" & _
                "<th style='width: 16%;'>Spot (X, Y)</th>" & _
                "<th style='width: 18%;'>Target Color</th>" & _
                "<th style='width: 20%;'>Value / Param</th>" & _
                "<th style='width: 10%;'>Delay (ms)</th>" & _
                "<th style='width: 5%;'>Tools</th>" & _
            "</tr></thead>"
        If includeTbody Then h = h & "<tbody id='seqTbody_" & key & "' data-seqname='" & HtmlEncodeAttr(seqName) & "'></tbody>"
        h = h & "</table>"
        SeqPanelHtml = h
    End Function

    Function MakeSeqPanel(seqName)
        Dim key, d, container
        key = SeqKey(seqName)
        Set d = document.createElement("div")
        d.id = "seqPanel_" & key
        d.className = "table-wrapper seq-panel"
        d.innerHTML = SeqPanelHtml(seqName, key, True)
        Set container = document.getElementById("seqContainer")
        If Not container Is Nothing Then container.appendChild(d)
        Set MakeSeqPanel = d
    End Function

    Sub RemoveSeqPanel(seqName)
        Dim panelEl
        On Error Resume Next
        Set panelEl = document.getElementById("seqPanel_" & SeqKey(seqName))
        If Not panelEl Is Nothing Then
            Set panelEl = panelEl.parentNode
            If Not panelEl Is Nothing Then panelEl.removeChild(document.getElementById("seqPanel_" & SeqKey(seqName)))
        End If
        On Error GoTo 0
    End Sub

    Sub RebuildSeqTabs()
        Dim container, html, i
        Set container = document.getElementById("seqTabsContainer")
        If container Is Nothing Then Exit Sub
        html = ""
        For i = 0 To UBound(arrSeqNames)
            If LCase(arrSeqNames(i)) = LCase(activeSeqName) Then
                html = html & "<span class='seq-tab active' onclick=""vbscript:SetActiveSequence('" & arrSeqNames(i) & "')"">" & HtmlEncodeAttr(arrSeqNames(i)) & "</span>"
            Else
                html = html & "<span class='seq-tab" & IIf(LCase(arrSeqNames(i)) = "main", " main-tab", "") & "' onclick=""vbscript:SetActiveSequence('" & arrSeqNames(i) & "')"">" & HtmlEncodeAttr(arrSeqNames(i)) & "</span>"
            End If
        Next
        container.innerHTML = html
    End Sub

    Sub AddNewSequence()
        Dim newName, i
        newName = InputBox("Nama sequence baru (huruf, angka, spasi, '-' dan '_'):", "Tambah Sequence", "Sequence " & (UBound(arrSeqNames) + 1))
        If Trim(newName) = "" Then Exit Sub
        newName = SanitizeSequenceName(newName)
        If newName = "" Then MsgBox "Nama tidak valid.", 48, "Error" : Exit Sub
        If LCase(newName) = "main" Then MsgBox "'MAIN' sudah dipakai sebagai sequence utama.", 48, "Error" : Exit Sub
        For i = 0 To UBound(arrSeqNames)
            If LCase(arrSeqNames(i)) = LCase(newName) Then MsgBox "Sequence '" & newName & "' sudah ada.", 48, "Error" : Exit Sub
        Next
        Call AddSeqToList(newName)
        Call MakeSeqPanel(newName)
        Call SyncSeqListToJS()
        Call RefreshAllBranchSelects()
        Call SetActiveSequence(newName)
        document.body.focus()
    End Sub

    Sub RenameSequence(oldName)
        On Error Resume Next
        If LCase(oldName) = "main" Then MsgBox "MAIN tidak bisa di-rename.", 48, "Info" : Exit Sub
        Dim newName, i, oldKey, newKey, tbody, oldPanel, container, newPanel, tableEl
        newName = InputBox("Nama baru untuk sequence:", "Rename Sequence", oldName)
        If Trim(newName) = "" Then Exit Sub
        newName = SanitizeSequenceName(newName)
        If newName = "" Then MsgBox "Nama tidak valid.", 48, "Error" : Exit Sub
        If LCase(newName) = "main" Then MsgBox "'MAIN' sudah dipakai.", 48, "Error" : Exit Sub
        For i = 0 To UBound(arrSeqNames)
            If LCase(arrSeqNames(i)) = LCase(newName) Then MsgBox "Sequence '" & newName & "' sudah ada.", 48, "Error" : Exit Sub
        Next

        Call UpdateBranchRefs(oldName, newName)

        oldKey = SeqKey(oldName)
        newKey = SeqKey(newName)
        Set tbody = document.getElementById("seqTbody_" & oldKey)
        Set oldPanel = document.getElementById("seqPanel_" & oldKey)
        If oldPanel Is Nothing Then Exit Sub

        Set newPanel = document.createElement("div")
        newPanel.id = "seqPanel_" & newKey
        newPanel.className = "table-wrapper seq-panel"
        newPanel.innerHTML = SeqPanelHtml(newName, newKey, False)
        If Not tbody Is Nothing Then
            Call tbody.setAttribute("id", "seqTbody_" & newKey)
            Call tbody.setAttribute("data-seqname", newName)
            Set tableEl = newPanel.getElementsByTagName("table")(0)
            Call tableEl.appendChild(tbody)
        End If
        Set container = oldPanel.parentNode
        Call container.insertBefore(newPanel, oldPanel)
        Call container.removeChild(oldPanel)

        For i = 0 To UBound(arrSeqNames)
            If LCase(arrSeqNames(i)) = LCase(oldName) Then arrSeqNames(i) = newName : Exit For
        Next
        If LCase(activeSeqName) = LCase(oldName) Then activeSeqName = newName
        window.activeSeqName = activeSeqName
        window.activeSeqTbodyId = "seqTbody_" & SeqKey(activeSeqName)
        Call SyncSeqListToJS()
        Call RebuildSeqTabs()
        Call RefreshAllBranchSelects()
        Call SetActiveSequence(activeSeqName)
        document.body.focus()
    End Sub

    Sub DeleteSequence(seqName)
        On Error Resume Next
        If LCase(seqName) = "main" Then MsgBox "MAIN tidak bisa dihapus.", 48, "Info" : Exit Sub
        If MsgBox("Hapus sequence '" & seqName & "' beserta semua step-nya?", 36, "Confirm Delete") <> 6 Then Exit Sub
        Call UpdateBranchRefs(seqName, "")
        Call RemoveSeqPanel(seqName)
        Call RemoveFromSeqList(seqName)
        If LCase(activeSeqName) = LCase(seqName) Then activeSeqName = "MAIN"
        Call SyncSeqListToJS()
        Call RefreshAllBranchSelects()
        Call SetActiveSequence(activeSeqName)
    End Sub

    Sub UpdateBranchRefs(fromName, toName)
        On Error Resume Next
        Dim i, tbody, rows, rowIdx, actVal, paramEl, val
        For i = 0 To UBound(arrSeqNames)
            Set tbody = document.getElementById("seqTbody_" & SeqKey(arrSeqNames(i)))
            If Not tbody Is Nothing Then
                For rowIdx = 0 To tbody.rows.length - 1
                    actVal = tbody.rows(rowIdx).getElementsByClassName("status-act")(0).value
                    If actVal = "CHECK PIXEL" Then
                        Set paramEl = tbody.rows(rowIdx).getElementsByClassName("status-param")(0)
                        val = paramEl.value
                        If LCase(val) = "seq:" & LCase(fromName) Then
                            If toName = "" Then paramEl.value = "WAIT" Else paramEl.value = "SEQ:" & toName
                        End If
                    End If
                Next
            End If
        Next
    End Sub

    Sub RefreshAllBranchSelects()
        On Error Resume Next
        Dim i, tbody, rowIdx, actVal, idStr, gid
        For i = 0 To UBound(arrSeqNames)
            Set tbody = document.getElementById("seqTbody_" & SeqKey(arrSeqNames(i)))
            If Not tbody Is Nothing Then
                For rowIdx = 0 To tbody.rows.length - 1
                    actVal = tbody.rows(rowIdx).getElementsByClassName("status-act")(0).value
                    If actVal = "CHECK PIXEL" Then
                        idStr = tbody.rows(rowIdx).getElementsByClassName("status-act")(0).id
                        If idStr <> "" Then
                            gid = Replace(idStr, "inp_act_", "")
                            If IsNumeric(gid) Then window.SyncParamField CInt(gid)
                        End If
                    End If
                Next
            End If
        Next
    End Sub

    Function HtmlEncodeAttr(s)
        s = Replace(s, "&", "&amp;")
        s = Replace(s, "<", "&lt;")
        s = Replace(s, ">", "&gt;")
        s = Replace(s, """", "&quot;")
        HtmlEncodeAttr = s
    End Function

    Function EscVBSStr(s)
        EscVBSStr = Replace(s, Chr(34), Chr(34) & Chr(34))
    End Function

    Sub SetLastRowName(nameVal)
        On Error Resume Next
        document.getElementById("inp_name_" & lastRowGid).value = nameVal
    End Sub

    Sub ResetAllSequences()
        Dim i, mainTbody
        For i = UBound(arrSeqNames) To 1 Step -1
            Call RemoveSeqPanel(arrSeqNames(i))
        Next
        ReDim arrSeqNames(0)
        arrSeqNames(0) = "MAIN"
        Set mainTbody = document.getElementById("seqTbody_MAIN")
        mainTbody.innerHTML = ""
        gRowIdCounter = 0
        Call SyncSeqListToJS()
        Call RebuildSeqTabs()
        Call SetActiveSequence("MAIN")
    End Sub

    Sub EnsureSequence(seqName)
        If SeqExists(seqName) Then Exit Sub
        If LCase(seqName) = "main" Then seqName = "MAIN"
        Call AddSeqToList(seqName)
        Call MakeSeqPanel(seqName)
    End Sub

    Sub SwitchTab(tabName)
        document.getElementById("tabGenerator").className = "tab-content"
        document.getElementById("tabLauncher").className = "tab-content"
        document.getElementById("btnTabGen").className = "tab-btn"
        document.getElementById("btnTabLaunch").className = "tab-btn"
        
        If tabName = "generator" Then
            document.getElementById("tabGenerator").className = "tab-content active"
            document.getElementById("btnTabGen").className = "tab-btn active"
        Else
            document.getElementById("tabLauncher").className = "tab-content active"
            document.getElementById("btnTabLaunch").className = "tab-btn active"
            timerId = window.setInterval("vbscript:ReadStatusLog()", 400)
        End If
    End Sub

    Sub GetTrueWindowsCursorAndColor(ByRef outX, ByRef outY, ByRef outHexColor)
        On Error Resume Next
        If objExcelEngine Is Nothing Then Set objExcelEngine = CreateObject("Excel.Application")
        
        Dim fullPos, hexPos, hexX, hexY
        fullPos = objExcelEngine.ExecuteExcel4Macro("CALL(""user32"",""GetMessagePos"",""J"")")
        hexPos = Hex(fullPos)
        Do While Len(hexPos) < 8 : hexPos = "0" & hexPos : Loop
        hexX = Right(hexPos, 4) : hexY = Left(hexPos, 4)
        outX = CLng("&H" & hexX) : outY = CLng("&H" & hexY)
        If outX > 32767 Then outX = outX - 65536
        If outY > 32767 Then outY = outY - 65536

        ' Fetch Screen Pixel Color using GDI32 API
        Dim hDC, rgbLong, rVal, gVal, bVal, hexR, hexG, hexB
        hDC = objExcelEngine.ExecuteExcel4Macro("CALL(""user32"",""GetDC"",""JJ"",0)")
        rgbLong = objExcelEngine.ExecuteExcel4Macro("CALL(""gdi32"",""GetPixel"",""JJJJ""," & hDC & "," & outX & "," & outY & ")")
        Call objExcelEngine.ExecuteExcel4Macro("CALL(""user32"",""ReleaseDC"",""JJJ"",0," & hDC & ")")

        If rgbLong >= 0 Then
            rVal = rgbLong Mod 256
            gVal = (rgbLong \ 256) Mod 256
            bVal = (rgbLong \ 65536) Mod 256
            
            hexR = Right("0" & Hex(rVal), 2)
            hexG = Right("0" & Hex(gVal), 2)
            hexB = Right("0" & Hex(bVal), 2)
            outHexColor = "#" & hexR & hexG & hexB
        Else
            outHexColor = "STATIC WAIT"
        End If
    End Sub

    Sub document_onkeydown
        Dim keyCode, shiftPressed
        keyCode = window.event.keyCode
        shiftPressed = window.event.shiftKey
        
        If shiftPressed Then
            Dim realX, realY, realColor
            Call GetTrueWindowsCursorAndColor(realX, realY, realColor)
            Select Case keyCode
                Case 67 ' Shift + C
                    window.event.returnValue = False
                    Call AddActionRowRouter("CLICK", realX, realY, realColor, "-", 600)
                Case 68 ' Shift + D
                    window.event.returnValue = False
                    Call AddActionRowRouter("DOUBLE CLICK", realX, realY, realColor, "-", 600)
                Case 82 ' Shift + R
                    window.event.returnValue = False
                    Call AddActionRowRouter("RIGHT CLICK", realX, realY, realColor, "-", 600)
                Case 77 ' Shift + M (Move Cursor Only)
                    window.event.returnValue = False
                    Call AddActionRowRouter("MOVE CURSOR ONLY", realX, realY, realColor, "-", 600)
                Case 87 ' Shift + W (Scroll Up)
                    window.event.returnValue = False
                    Call AddActionRowRouter("SCROLL UP", "-", "-", "STATIC WAIT", "1", 300)
                Case 83 ' Shift + S (Scroll Down)
                    window.event.returnValue = False
                    Call AddActionRowRouter("SCROLL DOWN", "-", "-", "STATIC WAIT", "1", 300)
                Case 79 ' Shift + O (Screenshot Full Screen)
                    window.event.returnValue = False
                    Call AddActionRowRouter("SCREENSHOT", "-", "-", "STATIC WAIT", "screenshot_" & (gRowIdCounter + 1) & ".png", 900)
                Case 73 ' Shift + I (Screenshot Region via overlay drag)
                    window.event.returnValue = False
                    Call TriggerRegionCapture()
                Case 88 ' Shift + X (Check Pixel / branch trigger)
                    window.event.returnValue = False
                    Call AddActionRowRouter("CHECK PIXEL", realX, realY, realColor, "WAIT", 600)
                Case 69 ' Shift + E (Edit Baris Terpilih Point & Shoot)
                    window.event.returnValue = False
                    If Not UpdateSelectedRowCoordinatesAndColor(realX, realY, realColor) Then
                        MsgBox "Pilih (klik) baris tabel terlebih dahulu untuk mengedit koordinat/warna!", 48, "Point & Shoot Edit"
                    End If
                Case 84 ' Shift + T
                    window.event.returnValue = False
                    Call TriggerTextCapture()
                Case 75 ' Shift + K
                    window.event.returnValue = False
                    Call TriggerShortcutCapture()
                Case 80 ' Shift + P
                    window.event.returnValue = False
                    Call TriggerProgramCapture()
            End Select
        End If
    End Sub

    Sub TriggerTextCapture()
        Dim txt
        txt = InputBox("Masukkan parameter teks yang ingin diketik secara otomatis:", "Type Text Input")
        If txt <> "" Then Call AddActionRowRouter("WRITE", "-", "-", "STATIC WAIT", txt, 600)
    End Sub

    Sub TriggerShortcutCapture()
        document.getElementById("shortcutModal").style.display = "flex"
    End Sub

    Sub CloseShortcutModal()
        document.getElementById("shortcutModal").style.display = "none"
        document.body.focus()
    End Sub

    Sub TriggerRegionCapture()
        On Error Resume Next
        Dim PathOverlay, FileOverlay, tmpPathJs, PathPreview, PreviewUrlJs, PathCapExe, preCmd
        PathOverlay = wshShell.CurrentDirectory & "\screenshot_overlay.hta"
        tmpPathJs = Replace(wshShell.CurrentDirectory & "\screenshot_region.tmp", "\", "/")
        PathCapExe = wshShell.CurrentDirectory & "\ScreenCap.exe"
        Call EnsureScreenCapEngine()
        PathPreview = wshShell.CurrentDirectory & "\screenshot_preview.png"
        PreviewUrlJs = "file:///" & Replace(PathPreview, "\", "/")
        preCmd = """" & PathCapExe & """ full """ & PathPreview & """"
        wshShell.Run preCmd, 0, True
        Set FileOverlay = FSO.CreateTextFile(PathOverlay, True)
        FileOverlay.WriteLine "<!DOCTYPE html>"
        FileOverlay.WriteLine "<html>"
        FileOverlay.WriteLine "<head>"
        FileOverlay.WriteLine "<meta http-equiv=""X-UA-Compatible"" content=""IE=edge"">"
        FileOverlay.WriteLine "<hta:application id=""regionSel"" showintaskbar=""no"" caption=""no"" border=""none"" innerborder=""no"" maximizebutton=""no"" minimizebutton=""no"" sysmenu=""no"" windowstate=""maximize"" scroll=""no"" />"
        FileOverlay.WriteLine "<style>"
        FileOverlay.WriteLine "html,body{width:100%;height:100%;margin:0;padding:0;overflow:hidden;background:#000 url('" & PreviewUrlJs & "') no-repeat center center;background-size:100% 100%;cursor:crosshair;}"
        FileOverlay.WriteLine "#mask{position:fixed;left:0;top:0;width:100%;height:100%;background:rgba(0,0,0,0.25);}"
        FileOverlay.WriteLine "#sel{position:fixed;display:none;border:2px solid #3b82f6;background:rgba(56,189,248,0.25);}"
        FileOverlay.WriteLine "#tip{position:fixed;left:50%;top:10px;transform:translateX(-50%);background:#111827;color:#38bdf8;padding:10px 18px;font-family:Segoe UI,Arial;font-size:14px;font-weight:700;border:1px solid #3b82f6;border-radius:6px;z-index:99;}"
        FileOverlay.WriteLine "</style>"
        FileOverlay.WriteLine "</head>"
        FileOverlay.WriteLine "<body>"
        FileOverlay.WriteLine "<div id=""tip"">Pilih Area: Klik-tahan & seret, lalu lepas. (ESC = Batal)</div>"
        FileOverlay.WriteLine "<div id=""mask""></div>"
        FileOverlay.WriteLine "<div id=""sel""></div>"
        FileOverlay.WriteLine "<script language=""javascript"">"
        FileOverlay.WriteLine "var sx=0,sy=0,dx=0,dy=0,dragging=false,scaleX=1,scaleY=1;"
        FileOverlay.WriteLine "var pv=new Image();pv.onload=function(){if(pv.width>0&&window.innerWidth>0)scaleX=pv.width/window.innerWidth;if(pv.height>0&&window.innerHeight>0)scaleY=pv.height/window.innerHeight;};pv.src='" & PreviewUrlJs & "';"
        FileOverlay.WriteLine "var mask=document.getElementById('mask'),sel=document.getElementById('sel');"
        FileOverlay.WriteLine "document.onmousedown=function(e){e.preventDefault();dragging=true;sx=window.event?window.event.clientX:e.clientX;sy=window.event?window.event.clientY:e.clientY;};"
        FileOverlay.WriteLine "document.onmousemove=function(e){if(!dragging)return;var cx=window.event?window.event.clientX:e.clientX,cy=window.event?window.event.clientY:e.clientY;dx=cx;dy=cy;drawSel();};"
        FileOverlay.WriteLine "document.onmouseup=function(e){if(!dragging)return;dragging=false;var cx=window.event?window.event.clientX:e.clientX,cy=window.event?window.event.clientY:e.clientY;dx=cx;dy=cy;finishSelect();};"
        FileOverlay.WriteLine "function drawSel(){var x1=Math.min(sx,dx),y1=Math.min(sy,dy),x2=Math.max(sx,dx),y2=Math.max(sy,dy);sel.style.left=x1+'px';sel.style.top=y1+'px';sel.style.width=(x2-x1)+'px';sel.style.height=(y2-y1)+'px';sel.style.display='block';}"
        FileOverlay.WriteLine "function finishSelect(){var x1=Math.min(sx,dx),y1=Math.min(sy,dy),x2=Math.max(sx,dx),y2=Math.max(sy,dy);if((x2-x1)<3||(y2-y1)<3){cancel();return;}"
        FileOverlay.WriteLine "var px1=Math.round(x1*scaleX),py1=Math.round(y1*scaleY),px2=Math.round(x2*scaleX),py2=Math.round(y2*scaleY);"
        FileOverlay.WriteLine "var fs=new ActiveXObject('Scripting.FileSystemObject');var tw=fs.CreateTextFile('" & tmpPathJs & "',true);tw.WriteLine(px1+','+py1+','+px2+','+py2);tw.Close();window.close();}"
        FileOverlay.WriteLine "function cancel(){try{var fs=new ActiveXObject('Scripting.FileSystemObject');var tw=fs.CreateTextFile('" & tmpPathJs & "',true);tw.WriteLine('-1,-1,-1,-1');tw.Close();}catch(e){}window.close();}"
        FileOverlay.WriteLine "window.onkeydown=function(e){if((window.event?window.event.keyCode:e.keyCode)===27)cancel();};"
        FileOverlay.WriteLine "</" & "script>"
        FileOverlay.WriteLine "</body>"
        FileOverlay.WriteLine "</html>"
        FileOverlay.Close

        ' Launch overlay non-blocking and poll asynchronously (no blocking busy-loop)
        wshShell.Run """" & PathOverlay & """", 1, False
        Call StartAsyncPoll(tmpPathJs)
    End Sub

    Sub StartAsyncPoll(tmpPathJs)
        ' Hand control to the JS interval poller; returns immediately to avoid mshta slow-script dialog
        window.StartRegionPoll tmpPathJs
    End Sub

    Sub CompleteRegionCapture(x1, y1, x2, y2)
        On Error Resume Next
        If CLng(x1) = -1 Then Exit Sub ' user cancelled
        Dim b1, b2, b3, b4
        b1 = CInt(x1) : b2 = CInt(y1) : b3 = CInt(x2 - x1) : b4 = CInt(y2 - y1)
        Call AddActionRowRouter("SCREENSHOT REGION", b1, b2, "STATIC WAIT", "region_" & (gRowIdCounter + 1) & ".png," & b3 & "x" & b4, 900)
    End Sub

    Sub SelectShortcut(valKey, defaultName)
        If valKey <> "" Then
            Call AddActionRowRouter("SHORTCUT", "-", "-", "STATIC WAIT", valKey, 600)
            Call SetLastRowName("Shortcut: " & defaultName)
        End If
        Call CloseShortcutModal()
    End Sub

    Sub OpenOSKModal()
        isCtrlActive = False: isShiftActive = False: isAltActive = False: selectedBaseKey = ""
        document.getElementById("k_CTRL").className = "k-btn modifier"
        document.getElementById("k_CTRL_R").className = "k-btn modifier"
        document.getElementById("k_SHIFT").className = "k-btn modifier"
        document.getElementById("k_SHIFT_R").className = "k-btn modifier"
        document.getElementById("k_ALT").className = "k-btn modifier"
        document.getElementById("oskShortcutName").value = "Custom Combo"
        Call UpdateOSKPreview()
        document.getElementById("oskModal").style.display = "flex"
    End Sub

    Sub CloseOSKModal()
        document.getElementById("oskModal").style.display = "none"
    End Sub

    Sub ToggleModifier(modName)
        If modName = "CTRL" Then
            isCtrlActive = Not isCtrlActive
            If isCtrlActive Then 
                document.getElementById("k_CTRL").className = "k-btn modifier active"
                document.getElementById("k_CTRL_R").className = "k-btn modifier active"
            Else 
                document.getElementById("k_CTRL").className = "k-btn modifier"
                document.getElementById("k_CTRL_R").className = "k-btn modifier"
            End If
        ElseIf modName = "SHIFT" Then
            isShiftActive = Not isShiftActive
            If isShiftActive Then 
                document.getElementById("k_SHIFT").className = "k-btn modifier active"
                document.getElementById("k_SHIFT_R").className = "k-btn modifier active"
            Else 
                document.getElementById("k_SHIFT").className = "k-btn modifier"
                document.getElementById("k_SHIFT_R").className = "k-btn modifier"
            End If
        ElseIf modName = "ALT" Then
            isAltActive = Not isAltActive
            If isAltActive Then document.getElementById("k_ALT").className = "k-btn modifier active" Else document.getElementById("k_ALT").className = "k-btn modifier"
        End If
        Call UpdateOSKPreview()
    End Sub

    Sub PressBaseKey(keyVal)
        selectedBaseKey = keyVal
        Call UpdateOSKPreview()
    End Sub

    Sub UpdateOSKPreview()
        Dim previewStr
        previewStr = ""
        If isCtrlActive Then previewStr = previewStr & "Ctrl + "
        If isShiftActive Then previewStr = previewStr & "Shift + "
        If isAltActive Then previewStr = previewStr & "Alt + "
        If selectedBaseKey <> "" Then
            Dim displayKey
            displayKey = Replace(Replace(Replace(Replace(Replace(selectedBaseKey, "{", ""), "}", ""), "UP", "▲"), "DOWN", "▼"), "LEFT", "◀")
            previewStr = previewStr & UCase(displayKey)
        Else
            previewStr = previewStr & "..."
        End If
        document.getElementById("oskPreview").innerText = previewStr
    End Sub

    Sub SaveOSKShortcut()
        Dim sendKeysCode, stepName
        sendKeysCode = ""
        stepName = document.getElementById("oskShortcutName").value
        If selectedBaseKey = "" Then MsgBox "Pilih tombol dasar keyboard virtual.", 48, "Notifikasi" : Exit Sub
        If isCtrlActive Then sendKeysCode = sendKeysCode & "^"
        If isShiftActive Then sendKeysCode = sendKeysCode & "+"
        If isAltActive Then sendKeysCode = sendKeysCode & "%"
        sendKeysCode = sendKeysCode & selectedBaseKey
        
        Call AddActionRowRouter("SHORTCUT", "-", "-", "STATIC WAIT", sendKeysCode, 600)
        Call SetLastRowName("Key: " & stepName)
        Call CloseOSKModal()
        Call CloseShortcutModal()
    End Sub

    Sub TriggerProgramCapture()
        document.getElementById("programModal").style.display = "flex"
    End Sub

    Sub CloseProgramModal()
        document.getElementById("programModal").style.display = "none"
        document.body.focus()
    End Sub

    Sub SelectProgram(appName, procName)
        Dim finalProc, displayTitle
        finalProc = procName : displayTitle = appName
        If finalProc = "" Then
            finalProc = InputBox("Masukkan nama executable target (contoh: Notepad):", "Switch Window Target")
            displayTitle = "Focus [" & finalProc & "]"
        End If
        If finalProc <> "" Then
            Call AddActionRowRouter("SWITCH_APP", "-", "-", "STATIC WAIT", finalProc, 800)
            Call SetLastRowName("Switch: " & displayTitle)
        End If
        Call CloseProgramModal()
    End Sub

    Sub BtnActionManual(act)
        Dim manualCoord
        manualCoord = InputBox("Masukkan koordinat manual X, Y:", "Input Manual", "250, 250")
        If manualCoord <> "" Then
            Dim parts
            parts = Split(manualCoord, ",")
            If UBound(parts) = 1 Then Call AddActionRowRouter(act, Trim(parts(0)), Trim(parts(1)), "STATIC WAIT", "-", 600)
        End If
    End Sub

    Sub AddActionRowRouter(actionType, mouseX, mouseY, colorVal, paramVal, delayMs)
        Call AddActionRow(activeSeqName, actionType, mouseX, mouseY, colorVal, paramVal, delayMs)
    End Sub

    Sub AddActionRow(seqName, actionType, mouseX, mouseY, colorVal, paramVal, delayMs)
        gRowIdCounter = gRowIdCounter + 1
        lastRowGid = gRowIdCounter
        Dim gid, key, tbody, row, bgChip
        gid = gRowIdCounter
        key = SeqKey(seqName)
        Set tbody = document.getElementById("seqTbody_" & key)
        If tbody Is Nothing Then Exit Sub
        Set row = tbody.insertRow(-1)
        row.id = "row_" & gid
        
        bgChip = "transparent"
        If Left(colorVal, 1) = "#" And Len(colorVal) = 7 Then bgChip = colorVal

        row.insertCell(0).innerHTML = "<input type='text' class='input-inline status-name' id='inp_name_" & gid & "' value='Langkah " & gid & "'>"
        row.insertCell(1).innerHTML = "<select class='select-inline status-act' id='inp_act_" & gid & "' onchange='SyncParamField(this)'>" & _
            "<option value='CLICK'" & IIf(actionType="CLICK"," selected","") & ">CLICK</option>" & _
            "<option value='DOUBLE CLICK'" & IIf(actionType="DOUBLE CLICK"," selected","") & ">DOUBLE CLICK</option>" & _
            "<option value='RIGHT CLICK'" & IIf(actionType="RIGHT CLICK"," selected","") & ">RIGHT CLICK</option>" & _
            "<option value='MOVE CURSOR ONLY'" & IIf(actionType="MOVE CURSOR ONLY"," selected","") & ">MOVE CURSOR ONLY</option>" & _
            "<option value='CHECK PIXEL'" & IIf(actionType="CHECK PIXEL"," selected","") & ">CHECK PIXEL</option>" & _
            "<option value='SCROLL UP'" & IIf(actionType="SCROLL UP"," selected","") & ">SCROLL UP</option>" & _
            "<option value='SCROLL DOWN'" & IIf(actionType="SCROLL DOWN"," selected","") & ">SCROLL DOWN</option>" & _
            "<option value='WRITE'" & IIf(actionType="WRITE"," selected","") & ">WRITE</option>" & _
            "<option value='SHORTCUT'" & IIf(actionType="SHORTCUT"," selected","") & ">SHORTCUT</option>" & _
            "<option value='SWITCH_APP'" & IIf(actionType="SWITCH_APP"," selected","") & ">SWITCH_APP</option>" & _
            "<option value='SCREENSHOT'" & IIf(actionType="SCREENSHOT"," selected","") & ">SCREENSHOT</option>" & _
            "<option value='SCREENSHOT REGION'" & IIf(actionType="SCREENSHOT REGION"," selected","") & ">SCREENSHOT REGION</option>" & _
            "</select>"
        row.insertCell(2).innerHTML = "<input type='text' class='input-inline status-coord' id='inp_coord_" & gid & "' value='" & HtmlEncodeAttr(mouseX & ", " & mouseY) & "'>"
        row.insertCell(3).innerHTML = "<span class='color-preview-chip' id='chip_" & gid & "' style='background-color:" & bgChip & ";'></span>" & _
            "<input type='text' class='input-inline status-color' id='inp_color_" & gid & "' style='width:75%;' value='" & HtmlEncodeAttr(colorVal) & "' onkeyup='UpdateColorChip(this)'>"
        row.insertCell(4).innerHTML = "<input type='text' class='input-inline status-param' id='inp_param_" & gid & "' value='" & HtmlEncodeAttr(paramVal) & "'>"
        row.insertCell(5).innerHTML = "<input type='text' class='input-inline status-delay' id='inp_delay_" & gid & "' value='" & HtmlEncodeAttr(delayMs) & "'>"
        row.insertCell(6).innerHTML = "<button class='btn-dup' style='padding:4px 8px; font-size:11px;' onclick='DuplicateRowBtn(this)'>📋</button> <button class='btn-danger' style='padding:4px 8px; font-size:11px;' onclick='DeleteRowBtn(this)'>❌</button>"
        
        Call InitDragAndDropListeners(row)
        Call window.SyncParamField(gid)
        document.body.focus()
    End Sub

    Function IIf(rel, trueVal, falseVal)
        If rel Then IIf = trueVal Else IIf = falseVal
    End Function

    Function MakeGhostDigits(rawStr)
        Dim i, ch, out
        out = ""
        For i = 1 To Len(rawStr)
            ch = Mid(rawStr, i, 1)
            If ch >= "0" And ch <= "9" Then ch = "8"
            out = out & ch
        Next
        MakeGhostDigits = out
    End Function

    Sub UpdateLoopTracker(valueStr)
        Dim ghostEl, liveEl
        Set ghostEl = document.getElementById("monLoopGhost")
        Set liveEl = document.getElementById("monLoopLive")
        If ghostEl Is Nothing Or liveEl Is Nothing Then Exit Sub
        ghostEl.innerText = MakeGhostDigits(valueStr)
        liveEl.innerText = valueStr
    End Sub

    Sub SaveSequenceMetadata()
        Dim seqName, seqFolder, seqPath, FileMeta
        Dim i, tbody, rows, rowIdx, curRow, totalRows

        totalRows = 0
        For i = 0 To UBound(arrSeqNames)
            Set tbody = document.getElementById("seqTbody_" & SeqKey(arrSeqNames(i)))
            If Not tbody Is Nothing Then totalRows = totalRows + tbody.rows.length
        Next
        If totalRows = 0 Then MsgBox "Semua sequence kosong. Nothing to save.", 48, "Warning" : Exit Sub

        seqName = InputBox("Enter a name for this sequence:" & vbCrLf & vbCrLf & _
                           "Letters, numbers, spaces, hyphens, underscores allowed." & vbCrLf & _
                           "Invalid characters will be removed.", _
                           "Save Sequence", "MySequence")
        If Trim(seqName) = "" Then Exit Sub

        seqName = SanitizeSequenceName(seqName)
        If seqName = "" Then MsgBox "Name is empty after sanitizing.", 48, "Error" : Exit Sub

        seqFolder = wshShell.CurrentDirectory & "\sequences"
        If Not FSO.FolderExists(seqFolder) Then FSO.CreateFolder seqFolder

        seqPath = seqFolder & "\" & seqName & ".txt"
        If FSO.FileExists(seqPath) Then
            If MsgBox("A sequence named '" & seqName & "' already exists." & vbCrLf & vbCrLf & _
                       "Overwrite it?", 36, "Confirm Overwrite") <> 6 Then Exit Sub
        End If

        Set FileMeta = FSO.CreateTextFile(seqPath, True)

        For i = 0 To UBound(arrSeqNames)
            Set tbody = document.getElementById("seqTbody_" & SeqKey(arrSeqNames(i)))
            If Not tbody Is Nothing And tbody.rows.length > 0 Then
                FileMeta.WriteLine "[SEQUENCE:" & arrSeqNames(i) & "]"
                For rowIdx = 0 To tbody.rows.length - 1
                    Set curRow = tbody.rows(rowIdx)
                    FileMeta.WriteLine curRow.getElementsByClassName("status-name")(0).value & "||" & _
                                       curRow.getElementsByClassName("status-act")(0).value & "||" & _
                                       curRow.getElementsByClassName("status-coord")(0).value & "||" & _
                                       curRow.getElementsByClassName("status-color")(0).value & "||" & _
                                       curRow.getElementsByClassName("status-param")(0).value & "||" & _
                                       curRow.getElementsByClassName("status-delay")(0).value & "||" & _
                                       curRow.getElementsByClassName("status-param")(0).value
                Next
            End If
        Next

        FileMeta.Close
        MsgBox "Multi-sequence '" & seqName & "' saved successfully!", 64, "Save Successful"
    End Sub

    Function SanitizeSequenceName(raw)
        Dim c, i, allowed
        allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 -_"
        raw = Trim(raw)
        SanitizeSequenceName = ""
        For i = 1 To Len(raw)
            c = Mid(raw, i, 1)
            If InStr(allowed, c) > 0 Then SanitizeSequenceName = SanitizeSequenceName & c
        Next
        If Len(SanitizeSequenceName) > 60 Then SanitizeSequenceName = Left(SanitizeSequenceName, 60)
    End Function

    Sub LoadSequenceMetadata()
        Dim seqFolder, seqFolderObj, seqFile, f, itemCount
        seqFolder = wshShell.CurrentDirectory & "\sequences"

        If Not FSO.FolderExists(seqFolder) Then
            MsgBox "No saved sequences found." & vbCrLf & vbCrLf & _
                   "Create one by clicking 'Save Sequence' first.", 48, "No Sequences"
            Exit Sub
        End If

        Set seqFolderObj = FSO.GetFolder(seqFolder)
        itemCount = 0
        ReDim seqFileNames(0), seqFileDates(0), seqFileSizes(0)
        For Each f In seqFolderObj.Files
            If LCase(FSO.GetExtensionName(f.Name)) = "txt" Then
                If itemCount > 0 Then ReDim Preserve seqFileNames(itemCount), seqFileDates(itemCount), seqFileSizes(itemCount)
                seqFileNames(itemCount) = Left(f.Name, Len(f.Name) - 4)
                seqFileDates(itemCount) = FormatDateTime(f.DateLastModified, vbShortDate) & " " & FormatDateTime(f.DateLastModified, vbShortTime)
                seqFileSizes(itemCount) = FormatFileSize(f.Size)
                itemCount = itemCount + 1
            End If
        Next

        If itemCount = 0 Then
            MsgBox "No saved sequences found." & vbCrLf & vbCrLf & _
                   "Create one by clicking 'Save Sequence' first.", 48, "No Sequences"
            Exit Sub
        End If

        Call PopulateSequencePicker(seqFileNames, seqFileDates, seqFileSizes, itemCount)
    End Sub

    Function FormatFileSize(bytesVal)
        If bytesVal < 1024 Then
            FormatFileSize = bytesVal & " B"
        ElseIf bytesVal < 1048576 Then
            FormatFileSize = Round(bytesVal / 1024, 1) & " KB"
        Else
            FormatFileSize = Round(bytesVal / 1048576, 1) & " MB"
        End If
    End Function

    Sub PopulateSequencePicker(names, dates, sizes, count)
        Dim html, i
        html = ""
        For i = 0 To count - 1
            html = html & "<div class='sequence-list-item' onclick=""vbscript:PickSequence('" & Replace(names(i), "'", "\'") & ".txt')"">" & _
                           "<span class='seq-name'>" & names(i) & "</span>" & _
                           "<span class='seq-meta'>" & sizes(i) & " &middot; " & dates(i) & "</span></div>"
        Next
        document.getElementById("sequenceListContainer").innerHTML = html
        document.getElementById("sequencePickerModal").style.display = "flex"
    End Sub

    Sub PickSequence(filename)
        Dim seqPath, objFile, lineStr, parts, section, partCount, branchArg, pX, pY, rowEl
        document.getElementById("sequencePickerModal").style.display = "none"

        seqPath = wshShell.CurrentDirectory & "\sequences\" & filename

        Call ResetAllSequences()

        If Not FSO.FileExists(seqPath) Then MsgBox "File not found: " & filename, 48, "Error" : Exit Sub

        section = ""
        Set objFile = FSO.OpenTextFile(seqPath, 1)
        Do Until objFile.AtEndOfStream
            lineStr = Trim(objFile.ReadLine)
            If lineStr <> "" Then
                If InStr(lineStr, "[SEQUENCE:") = 1 And Right(lineStr, 1) = "]" Then
                    section = Trim(Mid(lineStr, 11, Len(lineStr) - 11))
                    If section <> "" Then
                        If LCase(section) = "main" Then section = "MAIN"
                        Call EnsureSequence(section)
                    End If
                ElseIf lineStr = "[MAIN]" Then
                    section = "MAIN"
                ElseIf lineStr = "[EXTRA]" Then
                    section = "Extra"
                    Call EnsureSequence(section)
                ElseIf section <> "" Then
                    parts = Split(lineStr, "||")
                    partCount = UBound(parts)
                    If partCount >= 5 Then
                        pX = "-" : pY = "-"
                        If InStr(parts(2), ",") > 0 Then pX = Trim(Split(parts(2), ",")(0)) : pY = Trim(Split(parts(2), ",")(1))
                        branchArg = Trim(parts(4))
                        If partCount >= 6 Then branchArg = Trim(parts(6))
                        If branchArg = "" Then branchArg = "-"
                        Call AddActionRow(section, parts(1), pX, pY, parts(3), parts(4), parts(5))
                        Set rowEl = document.getElementById("row_" & lastRowGid)
                        If Not rowEl Is Nothing Then rowEl.setAttribute "data-branch", branchArg
                        Call SetLastRowName(parts(0))
                    End If
                End If
            End If
        Loop
        objFile.Close

        Call SyncSeqListToJS()
        Call RebuildSeqTabs()
        Call RefreshAllBranchSelects()
        Call ApplyStoredBranchValues()
        Call SetActiveSequence(section)

        MsgBox "Sequence loaded from '" & Left(filename, Len(filename) - 4) & "'!", 64, "Load Successful"
    End Sub

    Sub ApplyStoredBranchValues()
        On Error Resume Next
        Dim i, tbody, rowIdx, rowEl, storedVal
        For i = 0 To UBound(arrSeqNames)
            Set tbody = document.getElementById("seqTbody_" & SeqKey(arrSeqNames(i)))
            If Not tbody Is Nothing Then
                For rowIdx = 0 To tbody.rows.length - 1
                    Set rowEl = tbody.rows(rowIdx)
                    storedVal = rowEl.getAttribute("data-branch")
                    If storedVal <> "" Then
                        rowEl.getElementsByClassName("status-param")(0).value = storedVal
                    End If
                Next
            End If
        Next
        On Error GoTo 0
    End Sub

    Sub CloseSequencePicker()
        document.getElementById("sequencePickerModal").style.display = "none"
    End Sub

    Function GetShotFolderName()
        Dim v
        v = Trim(document.getElementById("inpShotFolder").value)
        If v = "" Then v = "screenshot"
        v = Replace(v, "\", "_")
        v = Replace(v, "/", "_")
        v = Replace(v, ":", "_")
        v = Replace(v, "*", "_")
        v = Replace(v, "?", "_")
        v = Replace(v, Chr(34), "_")
        v = Replace(v, "<", "_")
        v = Replace(v, ">", "_")
        v = Replace(v, "|", "_")
        If Len(v) > 60 Then v = Left(v, 60)
        If v = "" Then v = "screenshot"
        GetShotFolderName = v
    End Function

    Function GetShotOutputDir()
        GetShotOutputDir = wshShell.CurrentDirectory & "\" & GetShotFolderName()
    End Function

    Function GetShotStartNumber(dirAbs, prefix)
        Dim n, f, fsoIt, bn, midPart, numVal
        n = 1
        If FSO.FolderExists(dirAbs) Then
            Set f = FSO.GetFolder(dirAbs).Files
            For Each fsoIt In f
                bn = LCase(fsoIt.Name)
                If LCase(FSO.GetExtensionName(fsoIt.Name)) = "png" Then
                    If InStr(bn, LCase(prefix) & "_") = 1 Then
                        midPart = Mid(bn, Len(LCase(prefix)) + 2)
                        midPart = Left(midPart, Len(midPart) - 4)
                        If IsNumeric(midPart) Then
                            numVal = CLng(midPart)
                            If numVal >= n Then n = numVal + 1
                        End If
                    End If
                End If
            Next
        End If
        GetShotStartNumber = n
    End Function

    Sub EnsureScreenCapEngine()
        On Error Resume Next
        Dim PathCs, PathExe, FileCs, cscRes
        PathCs = wshShell.CurrentDirectory & "\ScreenCap.cs"
        PathExe = wshShell.CurrentDirectory & "\ScreenCap.exe"
        If FSO.FileExists(PathExe) Then Exit Sub

        Set FileCs = FSO.CreateTextFile(PathCs, True)
        FileCs.WriteLine "using System;"
        FileCs.WriteLine "using System.Drawing;"
        FileCs.WriteLine "using System.Drawing.Imaging;"
        FileCs.WriteLine "using System.Runtime.InteropServices;"
        FileCs.WriteLine "class ScreenCap{"
        FileCs.WriteLine "[DllImport(""user32.dll"")] static extern bool GetWindowRect(IntPtr h, out RECT r);"
        FileCs.WriteLine "[DllImport(""user32.dll"")] static extern bool PrintWindow(IntPtr h, IntPtr d, uint f);"
        FileCs.WriteLine "[DllImport(""user32.dll"")] static extern IntPtr GetForegroundWindow();"
        FileCs.WriteLine "[DllImport(""user32.dll"")] static extern int GetSystemMetrics(int i);"
        FileCs.WriteLine "[DllImport(""user32.dll"")] static extern bool SetProcessDPIAware();"
        FileCs.WriteLine "[StructLayout(LayoutKind.Sequential)] struct RECT{public int L,T,R,B;}"
        FileCs.WriteLine "static int Main(string[] a){"
        FileCs.WriteLine "SetProcessDPIAware();"
        FileCs.WriteLine "try{"
        FileCs.WriteLine "string mode=a[0], fn=a[1];"
        FileCs.WriteLine "if(mode==""window""){"
        FileCs.WriteLine "IntPtr hw=GetForegroundWindow(); RECT r; GetWindowRect(hw,out r);"
        FileCs.WriteLine "int w=r.R-r.L, hh=r.B-r.T;"
        FileCs.WriteLine "using(Bitmap b=new Bitmap(w,hh)){ using(Graphics g=Graphics.FromImage(b)){ IntPtr dc=g.GetHdc(); PrintWindow(hw,dc,0); g.ReleaseHdc(dc);} b.Save(fn,ImageFormat.Png);}"
        FileCs.WriteLine "return 0;}"
        FileCs.WriteLine "int sw=GetSystemMetrics(0), sh=GetSystemMetrics(1);"
        FileCs.WriteLine "using(Bitmap b=new Bitmap(sw,sh)){"
        FileCs.WriteLine "using(Graphics g=Graphics.FromImage(b)){ g.CopyFromScreen(0,0,0,0,new Size(sw,sh));}"
        FileCs.WriteLine "if(mode==""region""){ int x=int.Parse(a[2]),y=int.Parse(a[3]),w=int.Parse(a[4]),h=int.Parse(a[5]);"
        FileCs.WriteLine "int cx=System.Math.Max(0,x), cy=System.Math.Max(0,y), cw=System.Math.Min(w,sw-cx), ch=System.Math.Min(h,sh-cy); if(cw>0&&ch>0){ using(Bitmap c=b.Clone(new Rectangle(cx,cy,cw,ch),b.PixelFormat)){ c.Save(fn,ImageFormat.Png);} } return 0;}"
        FileCs.WriteLine "b.Save(fn,ImageFormat.Png);}"
        FileCs.WriteLine "return 0;"
        FileCs.WriteLine "}catch(System.Exception e){ return 1;}"
        FileCs.WriteLine "}}"
        FileCs.Close

        Dim cscPath
        cscPath = "C:\Windows\Microsoft.NET\Framework\v4.0.30319\csc.exe"
        If Not FSO.FileExists(cscPath) Then
            cscPath = "C:\Windows\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
        End If
        If Not FSO.FileExists(cscPath) Then
            MsgBox "Screenshot engine butuh .NET Framework csc.exe. Fitur SCREENSHOT tidak aktif.", 48, "ScreenCap"
            Exit Sub
        End If
        cscRes = wshShell.Run("""" & cscPath & """ /nologo /target:exe /out:""" & PathExe & """ """ & PathCs & """", 0, True)
    End Sub

Sub GenerateVBSOnly()
        Dim PathFile, FileVBS, loopInput, qShot
        qShot = Chr(34)
        Dim seqIdx, seqTbody, rowIdx, curRow
        Dim vName, vAct, vCoord, vColor, vParam, vDelay, mainShotIdx

        ' KETENTUAN 1: BILA SEQUENCE MAIN KOSONG (BLANK), FLOW LANGSUNG TERMINATED
        Set seqTbody = document.getElementById("seqTbody_MAIN")
        If seqTbody Is Nothing Or seqTbody.rows.length = 0 Then 
            MsgBox "Sequence MAIN kosong (blank)! Flow otomatis di-terminate.", 16, "Flow Terminated"
            Exit Sub 
        End If

        loopInput = InputBox("Loop Configuration:" & vbCrLf & "Ketik '1' = Sekali jalan" & vbCrLf & "Ketik 'inf' = Infinity loop", "Perulangan Eksekusi", "1")
        If loopInput = "" Then Exit Sub
        loopOpt = loopInput
        
        Call EnsureScreenCapEngine()
        
        Dim shotDirAbs, shotCounter, shotPrefix, mainShotSteps, stepIdx
        shotPrefix = GetShotFolderName()
        shotDirAbs = GetShotOutputDir()
        If Not FSO.FolderExists(shotDirAbs) Then FSO.CreateFolder shotDirAbs
        shotCounter = GetShotStartNumber(shotDirAbs, shotPrefix)
        mainShotSteps = 0
        For stepIdx = 0 To seqTbody.rows.length - 1
            Dim sActTmp
            sActTmp = seqTbody.rows(stepIdx).getElementsByClassName("status-act")(0).value
            If sActTmp = "SCREENSHOT" Or sActTmp = "SCREENSHOT REGION" Then mainShotSteps = mainShotSteps + 1
        Next
        If mainShotSteps = 0 Then mainShotSteps = 1

        PathFile = wshShell.CurrentDirectory & "\w.vbs"
        Set FileVBS = FSO.CreateTextFile(PathFile, True)
        
        FileVBS.WriteLine "Dim shotFld"
        FileVBS.WriteLine "shotFld = """ & shotDirAbs & """"

        FileVBS.WriteLine "' GENERATED ENGINE v1.5.0 Multi-Sequence & CHECK PIXEL Edition"
        FileVBS.WriteLine "Dim shl, ax, fso, currentLoop, maxLoop, runForever, ts, lastPhysX, lastPhysY, capExe, RunSeqShotIdx"
        FileVBS.WriteLine "RunSeqShotIdx = 0"
        FileVBS.WriteLine "Set shl = CreateObject(""WScript.Shell"")"
        FileVBS.WriteLine "Set ax = CreateObject(""Excel.Application"")"
        FileVBS.WriteLine "Set fso = CreateObject(""Scripting.FileSystemObject"")"
        FileVBS.WriteLine "capExe = fso.GetParentFolderName(WScript.ScriptFullName) & ""\ScreenCap.exe"""
        FileVBS.WriteLine "WScript.Sleep 1500"
        
        If LCase(loopInput) = "inf" Then
            FileVBS.WriteLine "maxLoop = 999999: runForever = True"
        Else
            FileVBS.WriteLine "maxLoop = " & CInt(loopInput) & ": runForever = False"
        End If
        
        ' Update posisi kursor acuan
        FileVBS.WriteLine "Sub UpdateLastCursorPos()"
        FileVBS.WriteLine "   On Error Resume Next"
        FileVBS.WriteLine "   Dim posHex, fullPos"
        FileVBS.WriteLine "   fullPos = ax.ExecuteExcel4Macro(""CALL(""""user32"""",""""GetMessagePos"""",""""J"""")"")"
        FileVBS.WriteLine "   posHex = Hex(fullPos)"
        FileVBS.WriteLine "   Do While Len(posHex) < 8 : posHex = ""0"" & posHex : Loop"
        FileVBS.WriteLine "   lastPhysX = CLng(""&H"" & Right(posHex, 4))"
        FileVBS.WriteLine "   lastPhysY = CLng(""&H"" & Left(posHex, 4))"
        FileVBS.WriteLine "   If lastPhysX > 32767 Then lastPhysX = lastPhysX - 65536"
        FileVBS.WriteLine "   If lastPhysY > 32767 Then lastPhysY = lastPhysY - 65536"
        FileVBS.WriteLine "End Sub"

        ' Deteksi gerakan fisik mouse saja
        FileVBS.WriteLine "Function IsMouseMoved()"
        FileVBS.WriteLine "   On Error Resume Next"
        FileVBS.WriteLine "   IsMouseMoved = False"
        FileVBS.WriteLine "   Dim posHex, fullPos, curX, curY"
        FileVBS.WriteLine "   fullPos = ax.ExecuteExcel4Macro(""CALL(""""user32"""",""""GetMessagePos"""",""""J"""")"")"
        FileVBS.WriteLine "   posHex = Hex(fullPos)"
        FileVBS.WriteLine "   Do While Len(posHex) < 8 : posHex = ""0"" & posHex : Loop"
        FileVBS.WriteLine "   curX = CLng(""&H"" & Right(posHex, 4))"
        FileVBS.WriteLine "   curY = CLng(""&H"" & Left(posHex, 4))"
        FileVBS.WriteLine "   If curX > 32767 Then curX = curX - 65536"
        FileVBS.WriteLine "   If curY > 32767 Then curY = curY - 65536"
        FileVBS.WriteLine "   If Abs(curX - lastPhysX) > 8 Or Abs(curY - lastPhysY) > 8 Then"
        FileVBS.WriteLine "       IsMouseMoved = True"
        FileVBS.WriteLine "   End If"
        FileVBS.WriteLine "End Function"

        ' Log khusus saat posisi HALTED / Countdown
        FileVBS.WriteLine "Sub LogHaltedStatus(remTimeSec)"
        FileVBS.WriteLine "   On Error Resume Next"
        FileVBS.WriteLine "   Set ts = fso.CreateTextFile(""" & Replace(PathStatusTmp, "\", "\\") & """, True)"
        FileVBS.WriteLine "   ts.WriteLine ""PHYSICAL_HOLD;"" & remTimeSec"
        FileVBS.WriteLine "   ts.Close"
        FileVBS.WriteLine "End Sub"

        ' Check hold dengan countdown 3 detik
        FileVBS.WriteLine "Sub CheckPhysicalHold()"
        FileVBS.WriteLine "   On Error Resume Next"
        FileVBS.WriteLine "   If IsMouseMoved() Then"
        FileVBS.WriteLine "       Dim idleMs, remSec"
        FileVBS.WriteLine "       idleMs = 0"
        FileVBS.WriteLine "       Do"
        FileVBS.WriteLine "           WScript.Sleep 100"
        FileVBS.WriteLine "           Call UpdateLastCursorPos()"
        FileVBS.WriteLine "           If IsMouseMoved() Then"
        FileVBS.WriteLine "               idleMs = 0"
        FileVBS.WriteLine "           Else"
        FileVBS.WriteLine "               idleMs = idleMs + 100"
        FileVBS.WriteLine "           End If"
        FileVBS.WriteLine "           remSec = FormatNumber((3000 - idleMs) / 1000, 1)"
        FileVBS.WriteLine "           If remSec < 0 Then remSec = 0"
        FileVBS.WriteLine "           Call LogHaltedStatus(remSec)"
        FileVBS.WriteLine "       Loop While idleMs < 3000"
        FileVBS.WriteLine "   End If"
        FileVBS.WriteLine "End Sub"

        FileVBS.WriteLine "Sub LogStatus(stepIdx, totalSteps, stepName)"
        FileVBS.WriteLine "   On Error Resume Next"
        FileVBS.WriteLine "   Set ts = fso.CreateTextFile(""" & Replace(PathStatusTmp, "\", "\\") & """, True)"
        FileVBS.WriteLine "   If runForever Then"
        FileVBS.WriteLine "       ts.WriteLine currentLoop & ""/INF;"" & stepIdx & ""/"" & totalSteps & "";"" & stepName"
        FileVBS.WriteLine "   Else"
        FileVBS.WriteLine "       ts.WriteLine currentLoop & ""/"" & maxLoop & "";"" & stepIdx & ""/"" & totalSteps & "";"" & stepName"
        FileVBS.WriteLine "   End If"
        FileVBS.WriteLine "   ts.Close"
        FileVBS.WriteLine "End Sub"
        
        FileVBS.WriteLine "Function WaitDynamicHoldColor(targetX, targetY, targetHexColor)"
        FileVBS.WriteLine "   On Error Resume Next"
        FileVBS.WriteLine "   If targetHexColor = """" Or UCase(targetHexColor) = ""STATIC WAIT"" Then Exit Function"
        FileVBS.WriteLine "   Dim hDC, rgbVal, curR, curG, curB, curHex"
        FileVBS.WriteLine "   Do"
        FileVBS.WriteLine "       Call CheckPhysicalHold()"
        FileVBS.WriteLine "       hDC = ax.ExecuteExcel4Macro(""CALL(""""user32"""",""""GetDC"""",""""JJ"""",0)"")"
        FileVBS.WriteLine "       rgbVal = ax.ExecuteExcel4Macro(""CALL(""""gdi32"""",""""GetPixel"""",""""JJJJ"""","" & hDC & "","" & targetX & "","" & targetY & "")"")"
        FileVBS.WriteLine "       ax.ExecuteExcel4Macro ""CALL(""""user32"""",""""ReleaseDC"""",""""JJJ"""",0,"" & hDC & "")"""
        FileVBS.WriteLine "       If rgbVal >= 0 Then"
        FileVBS.WriteLine "           curR = rgbVal Mod 256"
        FileVBS.WriteLine "           curG = (rgbVal \ 256) Mod 256"
        FileVBS.WriteLine "           curB = (rgbVal \ 65536) Mod 256"
        FileVBS.WriteLine "           curHex = ""#"" & Right(""0"" & Hex(curR), 2) & Right(""0"" & Hex(curG), 2) & Right(""0"" & Hex(curB), 2)"
        FileVBS.WriteLine "           If UCase(curHex) = UCase(targetHexColor) Then Exit Do"
        FileVBS.WriteLine "       End If"
        FileVBS.WriteLine "       WScript.Sleep 50"
        FileVBS.WriteLine "   Loop"
        FileVBS.WriteLine "End Function"

        ' CHECK PIXEL non-blocking pixel read
        FileVBS.WriteLine "Function ReadPixelHex(targetX, targetY)"
        FileVBS.WriteLine "   On Error Resume Next"
        FileVBS.WriteLine "   Dim hDC, rgbVal, curR, curG, curB"
        FileVBS.WriteLine "   ReadPixelHex = ""#000000"""
        FileVBS.WriteLine "   hDC = ax.ExecuteExcel4Macro(""CALL(""""user32"""",""""GetDC"""",""""JJ"""",0)"")"
        FileVBS.WriteLine "   rgbVal = ax.ExecuteExcel4Macro(""CALL(""""gdi32"""",""""GetPixel"""",""""JJJJ"""","" & hDC & "","" & targetX & "","" & targetY & "")"")"
        FileVBS.WriteLine "   ax.ExecuteExcel4Macro ""CALL(""""user32"""",""""ReleaseDC"""",""""JJJ"""",0,"" & hDC & "")"""
        FileVBS.WriteLine "   If rgbVal >= 0 Then"
        FileVBS.WriteLine "       curR = rgbVal Mod 256"
        FileVBS.WriteLine "       curG = (rgbVal \ 256) Mod 256"
        FileVBS.WriteLine "       curB = (rgbVal \ 65536) Mod 256"
        FileVBS.WriteLine "       ReadPixelHex = ""#"" & Right(""0"" & Hex(curR), 2) & Right(""0"" & Hex(curG), 2) & Right(""0"" & Hex(curB), 2)"
        FileVBS.WriteLine "   End If"
        FileVBS.WriteLine "End Function"

        FileVBS.WriteLine "Sub AutoSwitchActiveWindow(targetTitle)"
        FileVBS.WriteLine "   Dim cleanTitle, wmi, processes, exeName, isRunning, i"
        FileVBS.WriteLine "   On Error Resume Next"
        FileVBS.WriteLine "   cleanTitle = targetTitle"
        FileVBS.WriteLine "   If InStr(cleanTitle, "".exe"") > 0 Then"
        FileVBS.WriteLine "       exeName = cleanTitle: cleanTitle = Split(cleanTitle, "".exe"")(0)"
        FileVBS.WriteLine "   Else"
        FileVBS.WriteLine "       If LCase(cleanTitle) = ""notepad"" Then exeName = ""notepad.exe"""
        FileVBS.WriteLine "       If LCase(cleanTitle) = ""word"" Then exeName = ""winword.exe"""
        FileVBS.WriteLine "       If LCase(cleanTitle) = ""excel"" Then exeName = ""excel.exe"""
        FileVBS.WriteLine "       If exeName = """" Then exeName = cleanTitle & "".exe"""
        FileVBS.WriteLine "   End If"
        FileVBS.WriteLine "   Do"
        FileVBS.WriteLine "       isRunning = False"
        FileVBS.WriteLine "       Set wmi = GetObject(""winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2"")"
        FileVBS.WriteLine "       Set processes = wmi.ExecQuery(""SELECT * FROM Win32_Process WHERE Name='"" & exeName & ""'"")"
        FileVBS.WriteLine "       If processes.Count > 0 Then isRunning = True"
        FileVBS.WriteLine "       If isRunning Then"
        FileVBS.WriteLine "           For i = 1 To 2: shl.AppActivate(targetTitle): shl.AppActivate(cleanTitle): WScript.Sleep 150: Next"
        FileVBS.WriteLine "           Exit Do"
        FileVBS.WriteLine "       Else"
        FileVBS.WriteLine "           If MsgBox(""Target '"" & exeName & ""' belum aktif. Buka lalu klik OK."", 49, ""Error Focus"") = 2 Then WScript.Quit"
        FileVBS.WriteLine "       End If"
        FileVBS.WriteLine "   Loop"
        FileVBS.WriteLine "End Sub"        

        ' ============ SCREENSHOT ENGINE HELPER (uses pre-built ScreenCap.exe) ============
        FileVBS.WriteLine "Sub RunScreenshot(outFile, rx, ry, rw, rh)"
        FileVBS.WriteLine "   On Error Resume Next"
        FileVBS.WriteLine "   If Not fso.FileExists(capExe) Then Exit Sub"
        FileVBS.WriteLine "   If rx >= 0 And rw > 0 Then"
        FileVBS.WriteLine "    shl.Run Chr(34) & capExe & Chr(34) & "" region "" & Chr(34) & outFile & Chr(34) & "" "" & rx & "" "" & ry & "" "" & rw & "" "" & rh, 0, True"
        FileVBS.WriteLine "   Else"
        FileVBS.WriteLine "    shl.Run Chr(34) & capExe & Chr(34) & "" full "" & Chr(34) & outFile & Chr(34), 0, True"
        FileVBS.WriteLine "   End If"
        FileVBS.WriteLine "   WScript.Sleep 200"
        FileVBS.WriteLine "End Sub"

        ' ============ GENERATE ONE SUB PER SEQUENCE ============
        mainShotIdx = 0
        For seqIdx = 0 To UBound(arrSeqNames)
            Set seqTbody = document.getElementById("seqTbody_" & SeqKey(arrSeqNames(seqIdx)))
            If Not seqTbody Is Nothing And seqTbody.rows.length > 0 Then
                FileVBS.WriteLine "Sub RunSequence_" & SeqKey(arrSeqNames(seqIdx)) & "()"
                For rowIdx = 0 To seqTbody.rows.length - 1
                    Set curRow = seqTbody.rows(rowIdx)
                    vName = curRow.getElementsByClassName("status-name")(0).value
                    vAct = curRow.getElementsByClassName("status-act")(0).value
                    vCoord = curRow.getElementsByClassName("status-coord")(0).value
                    vColor = curRow.getElementsByClassName("status-color")(0).value
                    vParam = curRow.getElementsByClassName("status-param")(0).value
                    vDelay = curRow.getElementsByClassName("status-delay")(0).value

                    FileVBS.WriteLine "    Call CheckPhysicalHold()"
                    FileVBS.WriteLine "    Call LogStatus(" & (rowIdx + 1) & ", " & seqTbody.rows.length & ", """ & arrSeqNames(seqIdx) & " #" & (rowIdx + 1) & ": " & vName & " [" & vAct & "]"")"
                    If vAct = "SWITCH_APP" Then
                        FileVBS.WriteLine "    Call AutoSwitchActiveWindow(""" & vParam & """)"
                    ElseIf vAct = "CLICK" Or vAct = "DOUBLE CLICK" Or vAct = "RIGHT CLICK" Or vAct = "MOVE CURSOR ONLY" Then
                        If InStr(vCoord, ",") > 0 Then
                            Dim cParts, x, y
                            cParts = Split(vCoord, ","): x = Trim(cParts(0)): y = Trim(cParts(1))
                            If IsNumeric(x) And IsNumeric(y) Then
                                FileVBS.WriteLine "    Call WaitDynamicHoldColor(" & x & ", " & y & ", """ & vColor & """)"
                                FileVBS.WriteLine "    ax.ExecuteExcel4Macro ""CALL(""""user32"""",""""SetCursorPos"""",""""JJJ""""," & x & "," & y & ")"""
                                If vAct = "CLICK" Then
                                    FileVBS.WriteLine "    ax.ExecuteExcel4Macro ""CALL(""""user32"""",""""mouse_event"""",""""JJJJJJ"""",2,0,0,0,0)"""
                                    FileVBS.WriteLine "    ax.ExecuteExcel4Macro ""CALL(""""user32"""",""""mouse_event"""",""""JJJJJJ"""",4,0,0,0,0)"""
                                ElseIf vAct = "DOUBLE CLICK" Then
                                    FileVBS.WriteLine "    ax.ExecuteExcel4Macro ""CALL(""""user32"""",""""mouse_event"""",""""JJJJJJ"""",2,0,0,0,0)"""
                                    FileVBS.WriteLine "    ax.ExecuteExcel4Macro ""CALL(""""user32"""",""""mouse_event"""",""""JJJJJJ"""",4,0,0,0,0)"""
                                    FileVBS.WriteLine "    WScript.Sleep 100"
                                    FileVBS.WriteLine "    ax.ExecuteExcel4Macro ""CALL(""""user32"""",""""mouse_event"""",""""JJJJJJ"""",2,0,0,0,0)"""
                                    FileVBS.WriteLine "    ax.ExecuteExcel4Macro ""CALL(""""user32"""",""""mouse_event"""",""""JJJJJJ"""",4,0,0,0,0)"""
                                ElseIf vAct = "RIGHT CLICK" Then
                                    FileVBS.WriteLine "    ax.ExecuteExcel4Macro ""CALL(""""user32"""",""""mouse_event"""",""""JJJJJJ"""",8,0,0,0,0)"""
                                    FileVBS.WriteLine "    ax.ExecuteExcel4Macro ""CALL(""""user32"""",""""mouse_event"""",""""JJJJJJ"""",16,0,0,0,0)"""
                                End If
                                FileVBS.WriteLine "    Call UpdateLastCursorPos()"
                            End If
                        End If
                    ElseIf vAct = "CHECK PIXEL" Then
                        If InStr(vCoord, ",") > 0 Then
                            Dim ckParts, ckX, ckY
                            ckParts = Split(vCoord, ","): ckX = Trim(ckParts(0)): ckY = Trim(ckParts(1))
                            If IsNumeric(ckX) And IsNumeric(ckY) Then
                                If LCase(vParam) = "wait" Or Trim(vParam) = "-" Or Trim(vParam) = "" Then
                                    FileVBS.WriteLine "    Call WaitDynamicHoldColor(" & ckX & ", " & ckY & ", """ & vColor & """)"
                                ElseIf LCase(vParam) = "skip" Then
                                    FileVBS.WriteLine "    If UCase(ReadPixelHex(" & ckX & ", " & ckY & ")) = UCase(""" & vColor & """) Then Exit Sub"
                                ElseIf LCase(Left(vParam, 4)) = "seq:" Then
                                    Dim branchName, branchKey
                                    branchName = Trim(Mid(vParam, 5))
                                    If SeqExists(branchName) Then
                                        branchKey = SeqKey(branchName)
                                        FileVBS.WriteLine "    If UCase(ReadPixelHex(" & ckX & ", " & ckY & ")) = UCase(""" & vColor & """) Then Call RunSequence_" & branchKey
                                    Else
                                        MsgBox "CHECK PIXEL '" & vName & "' (di sequence """ & arrSeqNames(seqIdx) & """) menunjuk ke sequence yang tidak ada: """ & branchName & """.", 48, "Warning"
                                    End If
                                End If
                            End If
                        End If
                    ElseIf vAct = "SCROLL UP" Then
                        Dim scrollNotchesUp
                        scrollNotchesUp = 1
                        If IsNumeric(vParam) And CInt(vParam) > 0 Then scrollNotchesUp = CInt(vParam)
                        FileVBS.WriteLine "    ax.ExecuteExcel4Macro ""CALL(""""user32"""",""""mouse_event"""",""""JJJJJJ"""",2048,0,0," & (scrollNotchesUp * 120) & ",0)"""
                    ElseIf vAct = "SCROLL DOWN" Then
                        Dim scrollNotchesDown
                        scrollNotchesDown = 1
                        If IsNumeric(vParam) And CInt(vParam) > 0 Then scrollNotchesDown = CInt(vParam)
                        FileVBS.WriteLine "    ax.ExecuteExcel4Macro ""CALL(""""user32"""",""""mouse_event"""",""""JJJJJJ"""",2048,0,0," & (scrollNotchesDown * -120) & ",0)"""
                    ElseIf vAct = "SCREENSHOT" Then
                        If arrSeqNames(seqIdx) = "MAIN" Then
                            FileVBS.WriteLine "    Call RunScreenshot(shotFld & " & qShot & "\" & qShot & " & " & qShot & shotPrefix & "_" & qShot & " & (shotCounter + (currentLoop - 1) * " & mainShotSteps & " + " & mainShotIdx & ") & " & qShot & ".png" & qShot & ", -1, -1, -1, -1)"
                            mainShotIdx = mainShotIdx + 1
                        Else
                            FileVBS.WriteLine "    Call RunScreenshot(shotFld & " & qShot & "\" & qShot & " & " & qShot & shotPrefix & "_" & qShot & " & (shotCounter + maxLoop * " & mainShotSteps & " + RunSeqShotIdx) & " & qShot & ".png" & qShot & ", -1, -1, -1, -1)"
                            FileVBS.WriteLine "    RunSeqShotIdx = RunSeqShotIdx + 1"
                        End If
                    ElseIf vAct = "SCREENSHOT REGION" Then
                        Dim sRParts, sFileName, sWH, sWxH, sRCoord, sRx, sRy, sRw, sRh
                        sRParts = Split(vParam, ",")
                        sFileName = Trim(sRParts(0))
                        sWH = "-"
                        If UBound(sRParts) >= 1 Then sWH = Trim(sRParts(1))
                        sRx = "-" : sRy = "-"
                        If InStr(vCoord, ",") > 0 Then
                            sRCoord = Split(vCoord, ",")
                            sRx = Trim(sRCoord(0)) : sRy = Trim(sRCoord(1))
                        End If
                        sRw = "-" : sRh = "-"
                        If InStr(sWH, "x") > 0 Then
                            sWxH = Split(sWH, "x")
                            sRw = Trim(sWxH(0)) : sRh = Trim(sWxH(1))
                        End If
                        If IsNumeric(sRx) And IsNumeric(sRy) And IsNumeric(sRw) And IsNumeric(sRh) Then
                            If arrSeqNames(seqIdx) = "MAIN" Then
                                FileVBS.WriteLine "    Call RunScreenshot(shotFld & " & qShot & "\" & qShot & " & " & qShot & shotPrefix & "_" & qShot & " & (shotCounter + (currentLoop - 1) * " & mainShotSteps & " + " & mainShotIdx & ") & " & qShot & ".png" & qShot & ", " & sRx & ", " & sRy & ", " & sRw & ", " & sRh & ")"
                                mainShotIdx = mainShotIdx + 1
                            Else
                                FileVBS.WriteLine "    Call RunScreenshot(shotFld & " & qShot & "\" & qShot & " & " & qShot & shotPrefix & "_" & qShot & " & (shotCounter + maxLoop * " & mainShotSteps & " + RunSeqShotIdx) & " & qShot & ".png" & qShot & ", " & sRx & ", " & sRy & ", " & sRw & ", " & sRh & ")"
                                FileVBS.WriteLine "    RunSeqShotIdx = RunSeqShotIdx + 1"
                            End If
                        End If
                    ElseIf vAct = "WRITE" Or vAct = "SHORTCUT" Then
                        FileVBS.WriteLine "    shl.SendKeys """ & vParam & """"
                    End If
                    FileVBS.WriteLine "    WScript.Sleep " & vDelay
                Next
                FileVBS.WriteLine "End Sub"
            End If
        Next

        ' MAIN LOOP SCRIPT
        FileVBS.WriteLine "currentLoop = 0"
        FileVBS.WriteLine "Do While (currentLoop < maxLoop) Or runForever"
        FileVBS.WriteLine "    currentLoop = currentLoop + 1"
        FileVBS.WriteLine "    Call RunSequence_MAIN()"
        FileVBS.WriteLine "    If Not runForever And currentLoop >= maxLoop Then Exit Do"
        FileVBS.WriteLine "    WScript.Sleep 300"
        FileVBS.WriteLine "Loop"

        FileVBS.WriteLine "ax.Quit: Set ax = Nothing"
        FileVBS.WriteLine "On Error Resume Next"
        FileVBS.WriteLine "fso.DeleteFile(""" & Replace(PathStatusTmp, "\", "\\") & """)"
        FileVBS.WriteLine "MsgBox ""Kelar Deh Kerjaan Lu."", 64, ""Kelar Cuy"""
        FileVBS.Close
        
        MsgBox "File w.vbs berhasil di-generate!", 64, "Sukses"
    End Sub

    Sub ToggleEngineState()
        If isLaunchingState Or isTerminatingState Then Exit Sub
        If Not engineActive Then
            Call LaunchVBScript()
        Else
            Call ControlStop()
        End If
    End Sub

    Sub LaunchVBScript()
        Dim TargetPath
        TargetPath = wshShell.CurrentDirectory & "\w.vbs"
        If Not FSO.FileExists(TargetPath) Then MsgBox "File 'w.vbs' belum di-generate.", 48, "Error" : Exit Sub
        
        If FSO.FileExists(PathStatusTmp) Then FSO.DeleteFile(PathStatusTmp)
        If FSO.FileExists(PathPauseTmp) Then FSO.DeleteFile(PathPauseTmp)
        
        isLaunchingState = True
        engineActive = True
        startTime = Timer
        prepMsgIdx = 0
        lastEstUpdateSec = -10

        Dim masterBtn
        Set masterBtn = document.getElementById("btnMasterEngine")
        masterBtn.innerText = "⏳ RUNNING ENGINE..."
        masterBtn.disabled = True

        document.getElementById("boxAtomLoader").style.display = "block"

        If LCase(loopOpt) = "inf" Then
            document.getElementById("barTotalProg").className = "progress-bar-fill infinite-mode"
            document.getElementById("txtTotalProg").innerText = "∞ INFINITE LOOP"
        Else
            document.getElementById("barTotalProg").className = "progress-bar-fill total"
            document.getElementById("txtTotalProg").innerText = "0%"
        End If

        Call AnimateStatusText("INITIALIZING", "#38bdf8")
        
        wshShell.Run """" & TargetPath & """", 1, False
    End Sub

    Function FormatSeconds(secVal)
        Dim h, m, s
        If secVal < 0 Then secVal = 0
        h = Fix(secVal / 3600)
        m = Fix((secVal Mod 3600) / 60)
        s = Fix(secVal Mod 60)
        FormatSeconds = Right("0" & h, 2) & ":" & Right("0" & m, 2) & ":" & Right("0" & s, 2)
    End Function

    Sub RotateRandomTips()
        If engineActive Then
            tipTimerCounter = tipTimerCounter + 1
            If tipTimerCounter >= 20 Then
                tipTimerCounter = 0
                Dim rIdx
                rIdx = Int((UBound(arrFunTips) + 1) * Rnd)
                document.getElementById("txtFunTip").innerText = arrFunTips(rIdx)
            End If
        End If
    End Sub

Sub ReadStatusLog()
        On Error Resume Next
        
        Call RotateRandomTips()

        If engineActive Then
            Dim elapsed
            elapsed = Timer - startTime
            If elapsed < 0 Then elapsed = 0
            document.getElementById("txtElapsedTime").innerText = FormatSeconds(elapsed)
        End If

        If Not FSO.FileExists(PathStatusTmp) Then
            If isLaunchingState Then
                prepMsgIdx = (prepMsgIdx + 1) Mod 5
                Select Case prepMsgIdx
                    Case 0: document.getElementById("monStep").innerText = "⚡ Allocating Excel COM Threads..."
                    Case 1: document.getElementById("monStep").innerText = "🔍 Warming Up User32 API Hooks..."
                    Case 2: document.getElementById("monStep").innerText = "⚙️ Synchronizing Process Timers..."
                    Case 3: document.getElementById("monStep").innerText = "🛡️ Validating Target Handles..."
                    Case 4: document.getElementById("monStep").innerText = "🚀 Readying Execution Pipeline..."
                End Select
                Exit Sub
            End If
            
            If engineActive Then engineActive = False
            
            If Not isTerminatingState Then
                Dim masterBtn
                Set masterBtn = document.getElementById("btnMasterEngine")
                masterBtn.innerText = "▶ RUN ENGINE"
                masterBtn.className = "btn-success"
                masterBtn.disabled = False
            End If
            
            Call AnimateStatusText("IDLE", "#64748b")
            Call UpdateLoopTracker("0 / 0")
            document.getElementById("monStep").innerText = "-"
            document.getElementById("boxAtomLoader").style.display = "none"
            document.getElementById("txtFunTip").innerText = "💡 System ready. Silakan tekan RUN ENGINE untuk memulai eksekusi otomasi."
            
            document.getElementById("barLoopProg").style.width = "0%"
            document.getElementById("txtLoopProg").innerText = "0%"
            
            document.getElementById("barTotalProg").className = "progress-bar-fill total"
            document.getElementById("barTotalProg").style.width = "0%"
            document.getElementById("txtTotalProg").innerText = "0%"
            document.getElementById("txtEstTime").innerText = "00:00:00"
            Exit Sub
        End If

        If FSO.FileExists(PathStatusTmp) Then
            Dim objFile, fileContent, parts
            Set objFile = FSO.OpenTextFile(PathStatusTmp, 1, False)
            If Err.Number = 0 Then
                fileContent = objFile.ReadLine
                objFile.Close
                
                If fileContent <> "" Then
                    ' METODE 1: PENANGANAN STATUS HALTED (INPUT MOUSE DETECTED)
                    If InStr(fileContent, "PHYSICAL_HOLD;") = 1 Then
                        parts = Split(fileContent, ";")
                        Call AnimateStatusText("HALTED", "#f59e0b") ' Warna Orange / Amber
                        
                        Dim countdownVal
                        countdownVal = parts(1)
                        document.getElementById("monStep").innerHTML = "<span style='color:#f59e0b; font-weight:800;'>⏸️ User Interruption! Resuming in " & countdownVal & "s...</span>"
                        Exit Sub
                    End If

                    ' METODE 2: PENANGANAN STATUS NORMAL RUNNING
                    If InStr(fileContent, ";") > 0 Then
                        parts = Split(fileContent, ";")
                        
                        If isLaunchingState Then
                            isLaunchingState = False
                            Dim masterBtnRun
                            Set masterBtnRun = document.getElementById("btnMasterEngine")
                            masterBtnRun.innerText = "⏹️ TERMINATE ENGINE"
                            masterBtnRun.className = "btn-danger"
                            masterBtnRun.disabled = False
                        End If
                        
                        Call AnimateStatusText("RUNNING", "#10b981")
                        
                        Call UpdateLoopTracker(parts(0))
                        document.getElementById("monStep").innerText = parts(2)
                        
                        If UBound(parts) >= 1 Then
                            Dim stepParts, curStep, totStep
                            If InStr(parts(1), "/") > 0 Then
                                stepParts = Split(parts(1), "/")
                                curStep = CDbl(stepParts(0))
                                totStep = CDbl(stepParts(1))
                                
                                If totStep > 0 And curStep >= 0 Then
                                    Dim loopPct
                                    loopPct = Fix((curStep / totStep) * 100)
                                    If loopPct > 100 Then loopPct = 100
                                    document.getElementById("barLoopProg").style.width = loopPct & "%"
                                    document.getElementById("txtLoopProg").innerText = loopPct & "%"
                                    
                                    Dim loopInfoParts, curLoop, totLoop
                                    If InStr(parts(0), "/") > 0 Then
                                        loopInfoParts = Split(parts(0), "/")
                                        curLoop = CDbl(loopInfoParts(0))
                                        
                                        If IsNumeric(loopInfoParts(1)) Then
                                            totLoop = CDbl(loopInfoParts(1))
                                            If totLoop > 0 Then
                                                Dim totalPct
                                                totalPct = Fix((((curLoop - 1) * totStep + curStep) / (totStep * totLoop)) * 100)
                                                If totalPct > 100 Then totalPct = 100
                                                If totalPct < 0 Then totalPct = 0
                                                document.getElementById("barTotalProg").className = "progress-bar-fill total"
                                                document.getElementById("barTotalProg").style.width = totalPct & "%"
                                                document.getElementById("txtTotalProg").innerText = totalPct & "%"
                                                
                                                Dim currentElapsedSec
                                                currentElapsedSec = Timer - startTime
                                                If currentElapsedSec - lastEstUpdateSec >= 10 Then
                                                    lastEstUpdateSec = currentElapsedSec
                                                    Dim totalCompletedSteps, totalAllSteps, avgTimePerStep, remainingSteps, estSec
                                                    totalCompletedSteps = ((curLoop - 1) * totStep) + curStep
                                                    totalAllSteps = totStep * totLoop
                                                    remainingSteps = totalAllSteps - totalCompletedSteps
                                                    
                                                    If totalCompletedSteps > 0 And currentElapsedSec > 0 And remainingSteps > 0 Then
                                                        avgTimePerStep = currentElapsedSec / totalCompletedSteps
                                                        estSec = remainingSteps * avgTimePerStep
                                                        document.getElementById("txtEstTime").innerText = FormatSeconds(estSec)
                                                    End If
                                                End If
                                            End If
                                        Else
                                            document.getElementById("barTotalProg").className = "progress-bar-fill infinite-mode"
                                            document.getElementById("txtTotalProg").innerText = "∞ INFINITE LOOP"
                                            document.getElementById("txtEstTime").innerText = "∞ INFINITE"
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    End If
                End If
            End If
            Err.Clear
        End If
    End Sub

Sub ControlStop()
        On Error Resume Next
        isTerminatingState = True
        
        Dim masterBtn
        Set masterBtn = document.getElementById("btnMasterEngine")
        masterBtn.innerText = "⌛ TERMINATING..."
        masterBtn.disabled = True
        
        Call AnimateStatusText("TERMINATING", "#dc2626")
        
        ' ==========================================
        ' SAFE EXIT: NATIVE WMI PROCESS TERMINATION
        ' ==========================================
        Dim wmi, procList, proc
        Set wmi = GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
        
        ' 1. Target and kill ONLY the specific w.vbs execution engine
        Set procList = wmi.ExecQuery("SELECT * FROM Win32_Process WHERE Name='wscript.exe'")
        For Each proc In procList
            If InStr(LCase(proc.CommandLine), "w.vbs") > 0 Then
                proc.Terminate()
            End If
        Next
        
        ' 2. Clean up Excel processes spawned by the script (prevents memory leaks)
        ' Note: This mirrors your original logic but executes silently via WMI
        Set procList = wmi.ExecQuery("SELECT * FROM Win32_Process WHERE Name='excel.exe'")
        For Each proc In procList
            ' Only kill hidden Excel instances (running without command line arguments)
            If proc.CommandLine = """C:\Program Files\Microsoft Office\root\Office16\EXCEL.EXE""" Or InStr(LCase(proc.CommandLine), "automation") > 0 Then
                 proc.Terminate()
            End If
        Next
        ' ==========================================
        
        If FSO.FileExists(PathStatusTmp) Then FSO.DeleteFile(PathStatusTmp)
        If FSO.FileExists(PathPauseTmp) Then FSO.DeleteFile(PathPauseTmp)
        
        engineActive = False
        isLaunchingState = False
        isTerminatingState = False
        
        masterBtn.innerText = "▶ RUN ENGINE"
        masterBtn.className = "btn-success"
        masterBtn.disabled = False
        
        Call AnimateStatusText("IDLE", "#64748b")
        Call UpdateLoopTracker("0 / 0")
        document.getElementById("monStep").innerText = "-"
        document.getElementById("boxAtomLoader").style.display = "none"
        document.getElementById("txtFunTip").innerText = "💡 System ready. Silakan tekan RUN ENGINE untuk memulai eksekusi otomasi."
        
        document.getElementById("barLoopProg").style.width = "0%"
        document.getElementById("txtLoopProg").innerText = "0%"
        
        document.getElementById("barTotalProg").className = "progress-bar-fill total"
        document.getElementById("barTotalProg").style.width = "0%"
        document.getElementById("txtTotalProg").innerText = "0%"
        document.getElementById("txtEstTime").innerText = "00:00:00"
        
        MsgBox "Seluruh mesin otomasi dihentikan secara aman.", 64, "Proses Dimatikan"
    End Sub
</script>
</body>
</html>
