        </div>
        <div style="margin-bottom: 15px; text-align: left; padding: 0 10px;">
            <label style="font-weight: 700; font-size:13px; display:block; margin-bottom:5px; color:#ffffff;">Nama Custom Shortcut:</label>
            <input type="text" id="oskShortcutName" class="input-inline" style="width:100%; padding:8px; background:#0b0f17; color:#ffffff; border:1px solid #334155;" value="Custom Combo">
